<!DOCTYPE html>
<html data-motion="on" lang="ru">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<meta content="#000000" name="theme-color"/>
<meta content="dark" name="color-scheme"/>
<meta content="КУБ-2026 · Квантовая Сансара v3 — куб рассыпается на 14 000 частиц и собирается Колесом: 12 секторов × 5 кругов, генеративный звук, караоке, смысловые векторы, поиск. Нативный WebGL2, автономный HTML." name="description"/>
<meta content="КУБ-2026 — Квантовая Сансара · Polymat v3" property="og:title"/>
<meta content="60 треков на Колесе Сансары: 12 секторов × 5 кругов, генеративный бит, караоке и поиск. Автономный HTML без зависимостей." property="og:description"/>
<meta content="website" property="og:type"/>
<link href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23000'/%3E%3Crect x='14' y='14' width='36' height='36' fill='none' stroke='%23ffab40' stroke-width='2' transform='rotate(45 32 32)'/%3E%3Crect x='24' y='24' width='16' height='16' fill='%23ffab40' transform='rotate(45 32 32)'/%3E%3C/svg%3E" rel="icon"/>
<title>КУБ-2026 — Квантовая Сансара · Polymat v3</title>

<style>
:root {
  --font-display: "Unbounded Var", "Unbounded", system-ui, sans-serif;
  --font-body: "Manrope Var", "Manrope", system-ui, sans-serif;
  --font-mono: "JetBrains Mono Var", "JetBrains Mono", monospace;
  --font-read: "Golos Text Var", "Golos Text", "Manrope", system-ui, sans-serif;

  --skin: #e8e4df;
  --ash: #8a8580;
  --mute: #8a8580;
  --ember: #ffab40;
  --coal: #c45c26;
  --edge: #1f1c1a;
  --spoke: #ffab40;
  --spoke-dim: rgba(255,171,64,0.35);
  --spoke-glow: rgba(255,171,64,0.55);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  height: 100%;
  background: #000000;
  color: var(--skin);
  font-family: "Manrope Var", "Manrope", system-ui, sans-serif;
  overflow-x: hidden;
}
body { min-height: 100dvh; }
button { font: inherit; }

#gl {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
#fx {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}
html[data-motion="off"] #fx, html[data-motion="off"] #gl { display: none; }
html.gl-on #fx { display: none; }

.stage {
  position: relative;
  width: 100%;
  min-height: 100dvh;
  display: grid;
  place-items: center;
  overflow: hidden;
  z-index: 1;
}

.cube-wrap {
  position: relative;
  width: min(72vw, 420px);
  height: min(72vw, 420px);
  perspective: 900px;
  cursor: pointer;
  transition: transform 1.1s cubic-bezier(.4,0,.2,1), opacity .8s;
  z-index: 2;
}
.cube-wrap.is-axis {
  transform: scale(0.22);
  opacity: 0;
  pointer-events: none;
}
.cube {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transform: rotateX(-35deg) rotateY(45deg) rotateZ(0deg);
  animation: cubeSpin 28s linear infinite;
  will-change: transform;
}
html[data-motion="off"] .cube { animation: none; }
@keyframes cubeSpin {
  to { transform: rotateX(-35deg) rotateY(405deg) rotateZ(360deg); }
}
.face {
  position: absolute;
  inset: 12%;
  border: 1px solid var(--ember);
  background: #000000;
  backface-visibility: visible;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(6, 1fr);
  gap: 2px;
  padding: 4px;
}
.f-front  { transform: translateZ(calc(min(72vw, 420px) * 0.38)); }
.f-back   { transform: rotateY(180deg) translateZ(calc(min(72vw, 420px) * 0.38)); }
.f-right  { transform: rotateY(90deg) translateZ(calc(min(72vw, 420px) * 0.38)); }
.f-left   { transform: rotateY(-90deg) translateZ(calc(min(72vw, 420px) * 0.38)); }
.f-top    { transform: rotateX(90deg) translateZ(calc(min(72vw, 420px) * 0.38)); }
.f-bottom { transform: rotateX(-90deg) translateZ(calc(min(72vw, 420px) * 0.38)); }
.cell {
  border: 1px solid rgba(255,171,64,0.35);
  background: #000000;
  min-width: 0;
  min-height: 0;
  transition: background 0.2s, border-color 0.2s;
}
.cell:nth-child(odd) { background: #0a0a0a; }
.cube-wrap:hover .cell { border-color: rgba(255,171,64,0.55); }
.cube-wrap::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: -14%;
  height: 10%;
  background: radial-gradient(ellipse at center, rgba(255,171,64,0.22), transparent 70%);
  filter: blur(6px);
  pointer-events: none;
}
.hint {
  position: absolute;
  bottom: 6%;
  left: 50%;
  transform: translateX(-50%);
  color: var(--ash);
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.7;
  transition: opacity 0.5s;
  pointer-events: none;
  white-space: nowrap;
  z-index: 2;
}
.stage.is-wheel .hint,
.stage.is-grid .hint { opacity: 0; }

.wheel {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.9s ease 0.3s;
  z-index: 3;
}
.stage.is-wheel .wheel {
  opacity: 1;
  pointer-events: auto;
}
.wheel-inner {
  position: relative;
  width: min(92vw, 560px);
  height: min(92vw, 560px);
}
.ring-guide {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 1px solid rgba(255,171,64,0.08);
  border-radius: 50%;
  aspect-ratio: 1;
}
.ring-guide.rim {
  border-color: rgba(255,171,64,0.16);
}
.wheel-rotator {
  position: absolute;
  inset: 0;
  animation: wheelSpin 120s linear infinite;
  will-change: transform;
}
.wheel-inner:hover .wheel-rotator { animation-play-state: paused; }
html[data-motion="off"] .wheel-rotator { animation: none; }
@keyframes wheelSpin {
  to { transform: rotate(360deg); }
}
.spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1px;
  height: 33%;
  transform-origin: 50% 0;
  background: linear-gradient(
    to bottom,
    var(--spoke-glow) 0%,
    var(--spoke-dim) 40%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 1;
  opacity: 0.7;
  animation: spokePulse 3.2s ease-in-out infinite;
}
.spoke:nth-child(3n) { animation-delay: 0.5s; }
.spoke:nth-child(3n+1) { animation-delay: 1.1s; }
.spoke:nth-child(3n+2) { animation-delay: 1.7s; }
@keyframes spokePulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 0.85; }
}
html[data-motion="off"] .spoke {
  animation: none;
  opacity: 0.55;
}
.node {
  position: absolute;
  border-radius: 50%;
  border: 1px solid var(--ash);
  background: #000000;
  cursor: pointer;
  z-index: 4;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s, background 0.25s;
  display: grid;
  place-items: center;
  color: var(--mute);
  font-variant-numeric: tabular-nums;
  padding: 0;
  transform: translate(-50%, -50%) scale(var(--sc, 1));
}
.n-r0 { width: 4.8%; height: 4.8%; }
.n-r1 { width: 4.5%; height: 4.5%; }
.n-r2 { width: 4.2%; height: 4.2%; }
.n-r3 { width: 3.9%; height: 3.9%; }
.n-r4 { width: 3.6%; height: 3.6%; }
.node span {
  font-size: clamp(7px, 1.7vw, 10px);
  letter-spacing: 0.02em;
  pointer-events: none;
}
.node:hover, .node:focus-visible, .node.is-active {
  --sc: 1.18;
  border-color: var(--ember);
  color: var(--ember);
  background: #0a0a0a;
  box-shadow: 0 0 12px rgba(255,171,64,0.35);
  outline: none;
  z-index: 6;
}
.node.is-heard::before {
  content: "";
  width: 30%;
  height: 30%;
  border-radius: 50%;
  background: var(--ember);
  opacity: 0.55;
  position: absolute;
}
.node[data-s="shum"] { border-color: var(--coal); }
.node[data-s="gip"] { border-color: var(--ember); }
.axis {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 9%;
  height: 9%;
  transform: translate(-50%, -50%) rotate(45deg);
  border: 2px solid var(--ember);
  background: #000000;
  cursor: pointer;
  z-index: 5;
  transition: box-shadow 0.3s, background 0.3s;
}
.axis:hover, .axis:focus-visible {
  box-shadow: 0 0 0 6px rgba(255,171,64,0.2);
  background: rgba(255,171,64,0.12);
  outline: none;
}
.axis::after {
  content: "";
  position: absolute;
  inset: 18%;
  border: 1px solid rgba(255,171,64,0.5);
}
.axis.on-beat {
  box-shadow: 0 0 24px 6px rgba(255,171,64,0.45), 0 0 0 6px rgba(255,171,64,0.2);
}

.ghost-cube {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 15%;
  height: 15%;
  transform: translate(-50%, -50%);
  perspective: 320px;
  pointer-events: none;
  z-index: 2;
  opacity: 0.28;
}
.gc3d {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  animation: gcSpin 44s linear infinite;
}
@keyframes gcSpin {
  to { transform: rotateX(-30deg) rotateY(390deg) rotateZ(360deg); }
}
html[data-motion="off"] .gc3d { animation: none; }
.gc3d i {
  position: absolute;
  inset: 0;
  border: 1px solid var(--ember);
  background: transparent;
}
.gc3d i.g1 { transform: translateZ(50%); }
.gc3d i.g2 { transform: rotateY(180deg) translateZ(50%); }
.gc3d i.g3 { transform: rotateY(90deg) translateZ(50%); }
.gc3d i.g4 { transform: rotateY(-90deg) translateZ(50%); }
.gc3d i.g5 { transform: rotateX(90deg) translateZ(50%); }
.gc3d i.g6 { transform: rotateX(-90deg) translateZ(50%); }

.gridview {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: none;
  flex-direction: column;
  padding: 4.6rem 1.2rem 1.6rem;
  max-width: 64rem;
  margin: 0 auto;
}
.stage.is-grid .gridview { display: flex; }
.stage.is-grid .cube-wrap,
.stage.is-grid .wheel { opacity: 0; pointer-events: none; }
.grid-tools {
  display: flex;
  gap: 0.6rem;
  align-items: center;
  margin-bottom: 0.9rem;
}
.grid-tools input {
  flex: 1;
  background: #0a0a0a;
  border: 1px solid var(--edge);
  color: var(--skin);
  padding: 0.55rem 0.8rem;
  font: inherit;
  font-size: 0.9rem;
  min-height: 40px;
}
.grid-tools input:focus { outline: none; border-color: var(--ember); }
.grid-tools .found {
  color: var(--mute);
  font-size: 0.75rem;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
  gap: 0.5rem;
  overflow-y: auto;
  padding-bottom: 1rem;
  align-content: start;
}
.card {
  appearance: none;
  text-align: left;
  background: #050505;
  border: 1px solid var(--edge);
  color: var(--skin);
  padding: 0.6rem 0.7rem;
  cursor: pointer;
  display: grid;
  gap: 0.25rem;
  transition: border-color 0.2s, background 0.2s;
  min-height: 64px;
  position: relative;
}
.card:hover, .card:focus-visible {
  border-color: var(--ember);
  background: #0a0a0a;
  outline: none;
}
.card.is-active { border-color: var(--ember); }
.card .c-num {
  font-size: 0.68rem;
  color: var(--ember);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.1em;
}
.card .c-title {
  font-size: 0.85rem;
  line-height: 1.3;
  font-weight: 600;
}
.card .c-state {
  font-size: 0.64rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mute);
}
.card[data-s="shum"] .c-state { color: var(--coal); }
.card[data-s="gip"] .c-state { color: var(--ember); }
.card.is-heard::after {
  content: "";
  position: absolute;
  top: 0.6rem;
  right: 0.6rem;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--ember);
  opacity: 0.6;
}

.topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1rem;
  pointer-events: none;
  flex-wrap: wrap;
}
.topbar > * { pointer-events: auto; }
.brand {
  font-weight: 800;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
  color: var(--skin);
  text-decoration: none;
  white-space: nowrap;
}
.brand span { color: var(--ash); font-weight: 500; }
.brand .ver {
  color: var(--ember);
  font-weight: 700;
  font-size: 0.62rem;
  border: 1px solid rgba(255,171,64,0.4);
  padding: 0.05rem 0.3rem;
  margin-left: 0.35rem;
  letter-spacing: 0.12em;
  vertical-align: 1px;
}
.counter {
  color: var(--mute);
  font-size: 0.72rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.06em;
  margin-left: 0.2rem;
  white-space: nowrap;
}
.topbar .grow { flex: 1; }
.topbar button {
  appearance: none;
  border: 1px solid var(--edge);
  background: rgba(0,0,0,0.6);
  color: var(--ash);
  padding: 0.3rem 0.6rem;
  font-size: 0.75rem;
  cursor: pointer;
  min-height: 32px;
  letter-spacing: 0.03em;
}
.topbar button:hover, .topbar button:focus-visible {
  border-color: var(--ember);
  color: var(--ember);
  outline: none;
}
.topbar button[aria-pressed="true"] { color: var(--ember); border-color: var(--ember); }

.back-hint {
  position: fixed;
  top: 3.2rem;
  left: 50%;
  transform: translateX(-50%);
  color: var(--mute);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  opacity: 0;
  transition: opacity 0.5s;
  z-index: 25;
  pointer-events: none;
  text-align: center;
  width: min(94vw, 640px);
}
body.mode-wheel .back-hint, body.mode-grid .back-hint { opacity: 0.6; }

.legend {
  position: fixed;
  bottom: 0.9rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  color: var(--mute);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-align: center;
  width: min(94vw, 720px);
  line-height: 1.7;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.6s;
}
body.mode-wheel .legend { opacity: 0.85; }
.legend b { color: var(--ash); font-weight: 600; }
.legend .lg-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  vertical-align: 1px;
  margin: 0 0.2rem 0 0.6rem;
}
.legend .lg-text { border: 1px solid var(--ash); }
.legend .lg-shum { border: 1px solid var(--coal); }
.legend .lg-gip { border: 1px solid var(--ember); background: rgba(255,171,64,0.25); }

.toast {
  position: fixed;
  top: 3.4rem;
  left: 50%;
  transform: translateX(-50%) translateY(-8px);
  background: #0a0a0a;
  border: 1px solid var(--ember);
  color: var(--ember);
  font-size: 0.78rem;
  padding: 0.45rem 0.9rem;
  z-index: 60;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, transform 0.3s;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 20;
  background: linear-gradient(to top, #000 55%, rgba(0,0,0,0.92) 75%, transparent);
  padding: 1.5rem 1.2rem calc(1.4rem + env(safe-area-inset-bottom, 0px));
  transform: translateY(110%);
  transition: transform 0.55s cubic-bezier(.4,0,.2,1);
  pointer-events: none;
}
.panel.open {
  transform: translateY(0);
  pointer-events: auto;
}
.panel-inner {
  max-width: 40rem;
  margin: 0 auto;
  max-height: 74dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.panel-head {
  display: flex;
  align-items: baseline;
  gap: 0.7rem;
  margin-bottom: 0.2rem;
}
.panel .num {
  font-size: 0.7rem;
  color: var(--ember);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  font-variant-numeric: tabular-nums;
}
.state-chip {
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--mute);
  border: 1px solid var(--edge);
  padding: 0.08rem 0.4rem;
}
.state-chip[data-s="shum"] { color: var(--coal); border-color: var(--coal); }
.state-chip[data-s="gip"] { color: var(--ember); border-color: rgba(255,171,64,0.5); }
.panel .title {
  font-size: clamp(1.1rem, 1rem + 1vw, 1.45rem);
  font-weight: 700;
  margin-bottom: 0.3rem;
  color: var(--skin);
  letter-spacing: -0.01em;
}
.vec {
  color: var(--ash);
  font-size: 0.8rem;
  line-height: 1.45;
  font-style: italic;
  letter-spacing: 0.03em;
  margin-bottom: 0.7rem;
  padding-left: 0.85rem;
  border-left: 2px solid rgba(255,171,64,0.45);
}
.vec:empty { display: none; }
.viz {
  display: block;
  width: 100%;
  height: 30px;
  margin-bottom: 0.7rem;
  opacity: 0.9;
}
.panel:not(.is-playing) .viz { opacity: 0.35; }
.k-lines {
  display: grid;
  gap: 0.35rem;
  min-height: 4.8em;
  margin-bottom: 0.4rem;
}
.k-line {
  color: var(--mute);
  font-size: 0.92rem;
  line-height: 1.45;
  transition: color 0.35s, opacity 0.35s;
  opacity: 0.45;
}
.k-line.is-prev { opacity: 0.3; }
.k-line.is-active {
  color: var(--skin);
  opacity: 1;
  font-weight: 600;
  text-shadow: 0 0 20px rgba(255,171,64,0.25);
}
.k-line.is-next { opacity: 0.55; color: var(--ash); }
.k-chip {
  justify-self: start;
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ember);
  border: 1px solid rgba(255,171,64,0.4);
  padding: 0.1rem 0.45rem;
  margin-top: 0.3rem;
  opacity: 0.9;
}
.k-chip.is-active { opacity: 1; box-shadow: 0 0 10px rgba(255,171,64,0.2); }
.k-full {
  max-height: 34dvh;
  overflow-y: auto;
  display: grid;
  gap: 0.3rem;
  margin-bottom: 0.4rem;
  padding-right: 0.3rem;
}
.k-full[hidden] { display: none; }
.k-full .f-line {
  color: var(--ash);
  font-size: 0.88rem;
  line-height: 1.5;
  cursor: pointer;
  transition: color 0.2s;
}
.k-full .f-line:hover { color: var(--skin); }
.k-full .f-line.is-current {
  color: var(--skin);
  font-weight: 600;
}
.k-full .f-chip {
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ember);
  border: 1px solid rgba(255,171,64,0.4);
  padding: 0.08rem 0.4rem;
  justify-self: start;
  margin-top: 0.25rem;
}
.k-progress {
  height: 2px;
  background: var(--edge);
  margin: 0.4rem 0 0.8rem;
  overflow: hidden;
}
.k-progress i {
  display: block;
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--coal), var(--ember));
}
.panel-actions {
  display: flex;
  gap: 0.45rem;
  flex-wrap: wrap;
  align-items: center;
}
.panel-actions button {
  appearance: none;
  border: 1px solid var(--edge);
  background: transparent;
  color: var(--ash);
  padding: 0.4rem 0.85rem;
  font-size: 0.78rem;
  cursor: pointer;
  min-height: 36px;
  letter-spacing: 0.03em;
}
.panel-actions button:hover, .panel-actions button:focus-visible {
  border-color: var(--ember);
  color: var(--ember);
  outline: none;
}
.panel-actions .play-btn {
  border-color: var(--ember);
  color: var(--ember);
}
.panel-actions .play-btn[aria-pressed="true"] {
  background: var(--ember);
  color: #000;
}
.panel-actions input[type="range"] {
  appearance: none;
  -webkit-appearance: none;
  width: 84px;
  height: 2px;
  background: var(--edge);
  outline: none;
  margin-left: 0.2rem;
}
.panel-actions input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--ember);
  cursor: pointer;
}
.panel-actions input[type="range"]::-moz-range-thumb {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--ember);
  border: none;
  cursor: pointer;
}
.vol-wrap {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--mute);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

dialog#help {
  background: #050505;
  border: 1px solid var(--edge);
  color: var(--skin);
  max-width: 34rem;
  width: calc(100vw - 2rem);
  padding: 1.4rem 1.5rem;
  margin: auto;
}
dialog#help::backdrop {
  background: rgba(0,0,0,0.75);
  backdrop-filter: blur(3px);
}
dialog#help h2 {
  font-size: 1.05rem;
  margin-bottom: 0.7rem;
  color: var(--ember);
  letter-spacing: 0.04em;
}
dialog#help p, dialog#help li {
  font-size: 0.85rem;
  line-height: 1.6;
  color: var(--ash);
}
dialog#help ul { padding-left: 1.1rem; margin: 0.5rem 0 0.9rem; }
dialog#help kbd {
  border: 1px solid var(--edge);
  padding: 0.02rem 0.35rem;
  font-size: 0.75rem;
  color: var(--skin);
  background: #0a0a0a;
}
dialog#help .close-row { display: flex; justify-content: flex-end; margin-top: 0.6rem; }
dialog#help summary {
  cursor: pointer;
  color: var(--ember);
  font-size: 0.82rem;
  margin: 0.4rem 0;
}
dialog#help table.roadmap {
  width: 100%;
  border-collapse: collapse;
  margin: 0.4rem 0 0.8rem;
}
dialog#help table.roadmap th,
dialog#help table.roadmap td {
  border: 1px solid var(--edge);
  padding: 0.35rem 0.5rem;
  font-size: 0.76rem;
  color: var(--ash);
  text-align: left;
  vertical-align: top;
}
dialog#help table.roadmap th { color: var(--ember); font-weight: 600; }
dialog#help button {
  appearance: none;
  border: 1px solid var(--edge);
  background: transparent;
  color: var(--ash);
  padding: 0.4rem 0.9rem;
  cursor: pointer;
  font-size: 0.8rem;
}
dialog#help button:hover { border-color: var(--ember); color: var(--ember); }

html[data-motion="off"] .cube,
html[data-motion="off"] .wheel-rotator,
html[data-motion="off"] .spoke { animation: none !important; }
@media (prefers-reduced-motion: reduce) {
  .k-idl i { animation: none !important; }
  .cube, .wheel-rotator, .spoke, .cell, .node { animation: none !important; transition-duration: 0.01s !important; }
}

@media (max-width: 560px) {
  .brand span { display: none; }
  .topbar button { padding: 0.3rem 0.45rem; font-size: 0.7rem; }
  .counter { display: none; }
  .legend { font-size: 0.6rem; }
  .back-hint { font-size: 0.62rem; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(126px, 1fr)); }
}
</style>
<style>

@font-face{font-display:swap;}

@font-face{font-display:swap;}

@font-face{font-display:swap;}

@font-face{font-display:swap;}

h1,h2,h3,.p-title,.title,.brand,.panel-title{font-family:"Unbounded Var","Unbounded",system-ui,sans-serif !important;}
.k-line,.f-line,.panel-text,.k-lines{font-family:"Golos Text Var","Golos Text",Georgia,serif !important;}
.num,.chip,.kicker,.mono,.p-num{font-family:"JetBrains Mono Var","JetBrains Mono",ui-monospace,monospace !important;}
body,html,.panel,.hint,.toast{font-family:"Manrope Var","Manrope",system-ui,sans-serif !important;}

@media(hover:hover) and (pointer:fine){
.cube-wrap:hover .cell{border-color:rgba(255,171,64,0.55);}
.node:hover{transform:scale(1.35);border-color:var(--ember);color:var(--ember);background:#0a0a0a;box-shadow:0 0 12px rgba(255,171,64,0.35);}
.card:hover{border-color:var(--ember);}
.topbar button:hover{border-color:var(--ember);color:var(--ember);}
}

.topbar{padding:calc(0.7rem + env(safe-area-inset-top,0px)) calc(1rem + env(safe-area-inset-right,0px)) 0.7rem calc(1rem + env(safe-area-inset-left,0px));}
.legend{bottom:calc(0.9rem + env(safe-area-inset-bottom,0px));}
.toast{top:calc(3.4rem + env(safe-area-inset-top,0px));}
.back-hint{top:calc(3.2rem + env(safe-area-inset-top,0px));}
.stage{background:radial-gradient(circle at 50% 60%,#1a0f08,#000 70%);}


h1,h2,h3,.p-title,.title,.brand,.panel-title{font-family:"Unbounded Var","Unbounded",system-ui,sans-serif !important;}
.k-line,.f-line,.panel-text,.k-lines{font-family:"Golos Text Var","Golos Text",Georgia,serif !important;}
.num,.chip,.kicker,.mono,.p-num{font-family:"JetBrains Mono Var","JetBrains Mono",ui-monospace,monospace !important;}
body,html,.panel,.hint,.toast{font-family:"Manrope Var","Manrope",system-ui,sans-serif !important;}


/* ═══ V5 KARAOKE ENGINE CSS ═══ */

/* ============================================================
   КАРАОКЕ-ЛАБ v5 · эмерджентный движок караоке
   Практики: LRC/Enhanced-LRC (Wikipedia), гайдлайны Musixmatch/
   Spotify (правило «первого слова»), AMLL (word-glow, spring-scroll,
   интерлюдии), A Tale of Two Clocks (двойные часы+lookahead),
   MDN outputLatency (компенсация задержки вывода).
   Автономный файл: ноль внешних зависимостей.
   ============================================================ */
:root{
  --bg:#05060a; --bg2:#0a0d14; --ink:#e8ecf4; --dim:#8b93a7; --faint:#4a5064;
  --ember:#ff5a3c; --amber:#ffb054; --cyan:#35d0ff; --ok:#4ade80; --line:#1b2130;
  --panel:rgba(14,18,28,.82);
  --mono:'Sarasa Mono SC',ui-monospace,Menlo,Consolas,monospace;
  --sans:-apple-system,'SF Pro Text','Segoe UI Variable','Segoe UI',Roboto,'Noto Sans',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:
    radial-gradient(1100px 700px at 78% -12%, rgba(53,208,255,.075), transparent 62%),
    radial-gradient(900px 620px at 12% 112%, rgba(255,90,60,.085), transparent 60%),
    var(--bg);
  color:var(--ink); font-family:var(--sans);
  overflow:hidden; -webkit-font-smoothing:antialiased;
}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
button:focus-visible,a:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--cyan);outline-offset:2px;border-radius:8px}
.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.num{font-variant-numeric:tabular-nums}

/* ---------- каркас ---------- */
#app{height:100dvh;display:grid;grid-template-rows:auto auto 1fr auto auto}
header{
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  padding:10px 14px;border-bottom:1px solid var(--line);
  background:linear-gradient(180deg, rgba(10,13,20,.9), rgba(10,13,20,.55));
  backdrop-filter:blur(8px);
}
.brand{display:flex;flex-direction:column;line-height:1.1;margin-right:6px}
.brand b{font-size:15px;letter-spacing:.14em}
.brand b em{color:var(--ember);font-style:normal}
.brand span{font-size:10.5px;color:var(--dim);letter-spacing:.06em}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{
  font-size:12px;padding:5px 11px;border:1px solid var(--line);border-radius:999px;
  color:var(--dim);background:rgba(255,255,255,.02);transition:.18s;
}
.chip:hover{color:var(--ink);border-color:#2a3348}
.chip[aria-pressed="true"]{color:#0a0c12;background:var(--ember);border-color:var(--ember);font-weight:700}
.sep{width:1px;height:22px;background:var(--line);margin:0 2px}
.hgroup{display:flex;gap:6px;align-items:center}
.hgroup .lbl{font-size:10px;color:var(--faint);letter-spacing:.12em;text-transform:uppercase;margin-right:2px}

/* транспорт */
#transport{
  display:flex;align-items:center;gap:10px;padding:8px 14px;border-bottom:1px solid var(--line);
  background:rgba(8,10,16,.6);
}
.tbtn{
  width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
  border:1px solid #2a3348;color:var(--ink);transition:.18s;flex:none;
}
.tbtn:hover{border-color:var(--ember);color:var(--ember)}
.tbtn.main{width:40px;height:40px;background:var(--ember);border-color:var(--ember);color:#0a0c12}
.tbtn.main:hover{filter:brightness(1.12);color:#0a0c12}
#clockmode{display:flex;gap:4px}
#clockmode button{font-size:11px;padding:5px 9px;border:1px solid var(--line);border-radius:8px;color:var(--dim);letter-spacing:.04em}
#clockmode button[aria-pressed="true"]{color:var(--cyan);border-color:rgba(53,208,255,.55);background:rgba(53,208,255,.08)}
#timecode{font-family:var(--mono);font-size:12.5px;color:var(--dim);min-width:118px;text-align:center}
#bar{flex:1;height:26px;display:flex;align-items:center;cursor:pointer;min-width:120px}
#bar .rail{width:100%;height:4px;border-radius:4px;background:var(--line);position:relative;overflow:visible}
#bar .fill{position:absolute;inset:0 auto 0 0;width:0%;border-radius:4px;background:linear-gradient(90deg,var(--ember),var(--amber));transition:width .12s linear}
#bar .head{position:absolute;top:50%;left:0;width:11px;height:11px;border-radius:50%;background:#fff;transform:translate(-50%,-50%);box-shadow:0 0 10px rgba(255,90,60,.9);transition:left .12s linear}
#dur{font-family:var(--mono);font-size:11.5px;color:var(--faint)}

/* ---------- сцена текста ---------- */
#stage{position:relative;overflow:hidden;background:
  radial-gradient(800px 420px at 50% 118%, rgba(255,90,60,.05), transparent 60%);}
#scroller{position:absolute;inset:0;will-change:transform}
#stack{padding:42vh 6vw 55vh;max-width:980px;margin:0 auto}
@media (max-width:640px){ #stack{padding:34vh 6vw 46vh} }

.row{
  position:relative;
  font-size:clamp(21px,3.1vw,32px);line-height:1.32;font-weight:650;letter-spacing:.005em;
  color:var(--faint);opacity:.5;filter:blur(.6px);
  transition:color .45s,opacity .45s,filter .45s,transform .45s;
  transform-origin:0 62%;cursor:pointer;padding:7px 0;
  transform:scale(1);
}
.row:hover{color:var(--dim);opacity:.8}
.row.future{color:var(--dim);opacity:.62;filter:none}
.row.active{
  color:var(--ink);opacity:1;filter:none;cursor:default;
  transform:scale(1.055);font-weight:800;
  text-wrap:balance;
}
.row.past{color:var(--faint);opacity:.3;filter:blur(.5px)}

/* пословное двуслойное «протирание» (word wipe) */
.w{position:relative;display:inline-block;white-space:pre}
.w .bt{color:inherit;opacity:.92}
.w .gl{
  position:absolute;inset:0;color:var(--ink);
  background:linear-gradient(100deg,var(--amber),var(--ember) 55%,#ff7b4f);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  clip-path:inset(-8% 100% -12% 0);
  text-shadow:0 0 22px rgba(255,106,60,.55);
  will-change:clip-path;
}
@supports (mix-blend-mode:plus-lighter){
  .row.active .w .gl{mix-blend-mode:plus-lighter}
}
body.no-glow .w .gl{background:none;-webkit-text-fill-color:var(--ink);text-shadow:none;clip-path:inset(-8% -2% -12% 0)}
.row.sung .w .gl{clip-path:inset(-8% -2% -12% 0)}
.row:not(.active):not(.sung) .w .gl{clip-path:inset(-8% 100% -12% 0)!important}
.row.past .bt{opacity:.9}
.row.past.sung{color:#c9b9a5}

/* курсор-каретка предстоящего слова */
.row.active .w.current::after{
  content:'';position:absolute;left:-2px;bottom:.08em;width:.34em;height:.34em;border-radius:50%;
  background:var(--cyan);box-shadow:0 0 12px var(--cyan);opacity:.9;
}

/* чип секции (гайдлайн Musixmatch: #VERSE/#CHORUS) */
.chipsec{
  display:inline-flex;align-items:center;gap:8px;margin:26px 0 10px;
  font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--faint);
  user-select:none;
}
.chipsec::before{content:'';width:26px;height:1px;background:linear-gradient(90deg,var(--ember),transparent)}
.chipsec .tag{color:var(--ember);opacity:.85}

/* интерлюдия: «дыхание» между строками (практика AMLL) */
.idl{display:flex;gap:9px;align-items:center;height:38px;padding:6px 2px;opacity:0;transition:opacity .5s}
.idl i{width:7px;height:7px;border-radius:50%;background:var(--dim);animation:brea 1.9s infinite}
.idl i:nth-child(2){animation-delay:.32s}
.idl i:nth-child(3){animation-delay:.64s}
@keyframes brea{0%,100%{transform:scale(.7);opacity:.35}50%{transform:scale(1.25);opacity:.95}}
.idl.on{opacity:1}

/* ---------- нижняя панель: лаборатория ---------- */
#lab{
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  padding:9px 14px;border-top:1px solid var(--line);background:var(--panel);backdrop-filter:blur(10px);
}
#lab .grp{display:flex;align-items:center;gap:7px}
#lab .lbl{font-size:10px;color:var(--faint);letter-spacing:.12em;text-transform:uppercase}
#offv{font-family:var(--mono);font-size:11.5px;color:var(--cyan);min-width:56px;text-align:right}
input[type=range]{-webkit-appearance:none;appearance:none;width:150px;height:22px;background:transparent}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:4px;background:var(--line)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--cyan);margin-top:-5px;box-shadow:0 0 8px rgba(53,208,255,.8)}
input[type=range]::-moz-range-track{height:4px;border-radius:4px;background:var(--line)}
input[type=range]::-moz-range-thumb{width:14px;height:14px;border:none;border-radius:50%;background:var(--cyan)}
.lab-btn{
  font-size:12px;padding:6px 12px;border:1px solid #2a3348;border-radius:9px;color:var(--ink);
  background:rgba(255,255,255,.03);transition:.16s;
}
.lab-btn:hover{border-color:var(--amber);color:var(--amber)}
.lab-btn.hot{border-color:var(--ember);color:var(--ember);font-weight:700}
.lab-btn.on{background:rgba(255,90,60,.14)}
#tapbtn{min-width:118px}
#tapstate{font-family:var(--mono);font-size:11px;color:var(--dim)}
kbd{
  font-family:var(--mono);font-size:10px;padding:1px 5px;border:1px solid #2a3348;border-bottom-width:2px;
  border-radius:5px;color:var(--dim);background:#0d1119;
}

/* статусная строка */
#status{
  display:flex;gap:14px;align-items:center;flex-wrap:wrap;
  padding:6px 14px 9px;border-top:1px solid var(--line);background:rgba(6,8,12,.85);
  font-size:11px;color:var(--dim);
}
#status .dot{width:7px;height:7px;border-radius:50%;background:var(--faint);display:inline-block;margin-right:5px;vertical-align:1px}
#status .dot.ok{background:var(--ok);box-shadow:0 0 8px rgba(74,222,128,.7)}
#status .dot.warn{background:var(--amber);box-shadow:0 0 8px rgba(255,176,84,.7)}
#latout{font-family:var(--mono)}
#srcline{color:var(--faint);font-family:var(--mono);max-width:52ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* тосты */
#toasts{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);display:grid;gap:8px;z-index:60;pointer-events:none}
.toast{
  font-size:12.5px;padding:9px 16px;border-radius:12px;border:1px solid #2a3348;
  background:rgba(12,16,26,.94);color:var(--ink);box-shadow:0 10px 34px rgba(0,0,0,.5);
  animation:tin .28s cubic-bezier(.2,.9,.3,1.2);
}
.toast.warn{border-color:rgba(255,176,84,.5)}
@keyframes tin{from{opacity:0;transform:translateY(10px) scale(.96)}to{opacity:1;transform:none}}

/* диалог импорта/экспорта */
dialog{
  border:1px solid #2a3348;border-radius:16px;background:#0b0f18;color:var(--ink);
  padding:0;width:min(660px,94vw);box-shadow:0 30px 90px rgba(0,0,0,.6);
}
dialog::backdrop{background:rgba(3,4,8,.7);backdrop-filter:blur(3px)}
.dlg-h{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
.dlg-h b{font-size:14px;letter-spacing:.08em}
.dlg-b{padding:14px 18px;display:grid;gap:10px}
.dlg-b p{font-size:12.5px;color:var(--dim);line-height:1.55}
textarea{
  width:100%;min-height:190px;resize:vertical;border-radius:10px;border:1px solid #2a3348;
  background:#080b12;color:var(--ink);font-family:var(--mono);font-size:12px;padding:10px;
}
.dlg-f{display:flex;gap:8px;justify-content:flex-end;padding:0 18px 16px}
#dropzone{border:1.5px dashed #2a3348;border-radius:10px;padding:10px;text-align:center;font-size:12px;color:var(--faint)}
#dropzone.hot{border-color:var(--cyan);color:var(--cyan)}

/* оверлей-подсказка при первом запуске */
#hint{
  position:absolute;left:50%;top:16vh;transform:translateX(-50%);
  text-align:center;pointer-events:none;transition:opacity .7s;color:var(--dim);
}
#hint b{display:block;font-size:12px;letter-spacing:.3em;color:var(--faint);margin-bottom:8px}
#hint span{font-size:clamp(17px,2.4vw,24px);color:#aab3c7;font-weight:600}
#hint.gone{opacity:0}

/* reduced motion: отключаем пульсации/плавности (практика prefers-reduced-motion) */
@media (prefers-reduced-motion:reduce){
  *{transition-duration:.01ms!important;animation-duration:.01ms!important}
  .idl i{animation:none}
}
body[data-motion="off"] *{transition-duration:.01ms!important;animation-duration:.01ms!important}
body[data-motion="off"] .idl i{animation:none}

@media (max-width:760px){
  header{gap:7px;padding:9px 10px}
  #transport{flex-wrap:wrap;row-gap:6px}
  #bar{flex-basis:100%;min-width:0;order:9}
  #timecode{min-width:92px}
  #lab{gap:8px;padding:8px 10px}
  #tapbtn{min-width:92px}
  .hide-m{display:none}
}

.k-line.is-active .w .gl{will-change:clip-path;}
.k-line:not(.is-active) .w .gl{will-change:auto;}

/* V5 KARAOKE ENGINE CSS */

/* ============================================================
   КАРАОКЕ-ЛАБ v5 · эмерджентный движок караоке
