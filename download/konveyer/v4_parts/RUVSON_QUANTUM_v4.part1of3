    radial-gradient(1100px 700px at 78% -12%, rgba(53,208,255,.075), transparent 62%),
    radial-gradient(900px 620px at 12% 112%, rgba(255,90,60,.085), transparent 60%),
    var(--bg);
  color:var(--ink); font-family:var(--sans);
