  "недоверие как броня",
  "окно возможностей",
  "доверие ходу времени",
  "плато мудрости и затишье перед взлётом"
];

const Dust = (() => {
  const N=82;
  let gl = null, prog = null, buf = null, rndBuf = null, loc = {}, ok = false;
  let frameBuf = null;
  let aFrom = null, aTo = null, aRnd = null;
  let cubeT = null, wheelT = null;
  let state = "cube", mixV = 1, morphing = false, morphT0 = 0;
  let beatV = 0;
  let spinY = 0, spinZ = 0, tiltX = -0.08, tgtTX = -0.08, offY = 0, tgtOY = 0;
  let raf = null, lastT = 0;
  const VS = `#version 300 es
  layout(location=0) in vec3 aPos;
  layout(location=1) in float aRnd;
  uniform float uRX, uRY, uRZ, uAspect, uTime, uBeat;
  out float vA; out float vR;
  void main(){
    vec3 p = aPos;
    float cy = cos(uRY), sy = sin(uRY);
    p = vec3(cy*p.x + sy*p.z, p.y, -sy*p.x + cy*p.z);
    float cz = cos(uRZ), sz = sin(uRZ);
    p = vec3(cz*p.x - sz*p.y, sz*p.x + cz*p.y, p.z);
    float cx = cos(uRX), sx = sin(uRX);
    p = vec3(p.x, cx*p.y - sx*p.z, sx*p.y + cx*p.z);
    float z = p.z + 4.6;
    float f = 2.4 / max(z, 0.2);
    gl_Position = vec4(p.x * f * uAspect, p.y * f, 0.0, 1.0);
    gl_PointSize = clamp((0.85 + aRnd * 1.9) * (1.0 + uBeat * 0.8) * f * 300.0, 1.0, 7.0);
    vA = clamp(2.1 - z * 0.38, 0.08, 1.0) * (0.55 + 0.45 * fract(aRnd * 7.13));
    vR = aRnd;
  }`;
  const FS = `#version 300 es
  precision highp float;
  in float vA; in float vR;
  uniform float uBeat;
  out vec4 o;
  void main(){
    vec2 d = gl_PointCoord - 0.5;
    float m = smoothstep(0.5, 0.06, length(d));
    vec3 col = mix(vec3(1.0, 0.67, 0.25), vec3(0.77, 0.36, 0.15), vR);
    o = vec4(col, m * vA * (0.7 + uBeat * 0.3));
  }`;
  function sh(type, src) {
    const s = gl.createShader(type);
    gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
    return s;
  }
  function genCube() {
    const a = new Float32Array(N * 3), S = 0.95;
    const E = [[-S,-S,-S,S,-S,-S],[S,-S,-S,S,S,-S],[S,S,-S,-S,S,-S],[-S,S,-S,-S,-S,-S],
               [-S,-S,S,S,-S,S],[S,-S,S,S,S,S],[S,S,S,-S,S,S],[-S,S,S,-S,-S,S],
               [-S,-S,-S,-S,-S,S],[S,-S,-S,S,-S,S],[S,S,-S,S,S,S],[-S,S,-S,-S,S,S]];
    for (let i = 0; i < N; i++) {
      let x, y, z;
      if (i < N * 0.52) {
        const e = E[(Math.random() * 12) | 0], t = Math.random();
        x = e[0] + (e[3] - e[0]) * t; y = e[1] + (e[4] - e[1]) * t; z = e[2] + (e[5] - e[2]) * t;
      } else if (i > N * 0.94) {

        const th = Math.random() * Math.PI * 2, ph = Math.acos(Math.random() * 2 - 1);
        const rr = S * (1.05 + Math.random() * 0.5);
        x = rr * Math.sin(ph) * Math.cos(th); y = rr * Math.cos(ph); z = rr * Math.sin(ph) * Math.sin(th);
      } else {
        const f = (Math.random() * 6) | 0, u = (Math.random() * 2 - 1) * S, v = (Math.random() * 2 - 1) * S;
        x = f < 2 ? (f === 0 ? S : -S) : u;
        y = f >= 2 && f < 4 ? (f === 2 ? S : -S) : v;
        z = f >= 4 ? (f === 4 ? S : -S) : (f < 2 ? v : u);
      }
      a[i*3] = x; a[i*3+1] = y; a[i*3+2] = z;
    }
    return a;
  }
  function genWheel() {
    const a = new Float32Array(N * 3);
    const R = [0.26, 0.42, 0.58, 0.74, 0.9];
    for (let i = 0; i < N; i++) {
      let r, ang, x, y;
      const kind = Math.random();
      if (kind < 0.62) {
        r = R[(Math.random() * 5) | 0]; ang = Math.random() * Math.PI * 2;
      } else if (kind < 0.85) {
        const s = ((Math.random() * 12) | 0) * (Math.PI / 6);
        r = 0.12 + Math.random() * 0.78; ang = s + (Math.random() - 0.5) * 0.02;
      } else {
        r = 0.96 + Math.random() * 0.14; ang = Math.random() * Math.PI * 2;
      }
      x = Math.cos(ang) * r; y = Math.sin(ang) * r;
      a[i*3] = x; a[i*3+1] = y; a[i*3+2] = (Math.random() - 0.5) * 0.1;
    }
    return a;
  }
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 1.0);
    const w = Math.round(window.innerWidth * dpr), h = Math.round(window.innerHeight * dpr);
    if (gl.canvas.width !== w || gl.canvas.height !== h) {
      gl.canvas.width = w; gl.canvas.height = h;
      gl.viewport(0, 0, w, h);
    }
  }
  function frame(now) {
    if (!ok) return;
    raf = requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - lastT) / 1000 || 0.016); lastT = now;
    const t = now / 1000;
    resize();

    if (morphing) {
      mixV = Math.min(1, (now - morphT0) / 1700);
      if (mixV >= 1) { morphing = false; const tmp = aFrom;  }
    }
    const e = morphing ? (mixV < 0.5 ? 2*mixV*mixV : 1 - Math.pow(-2*mixV + 2, 2) / 2) : 1;
    const turb = morphing ? 0.05 + 0.5 * Math.sin(Math.PI * mixV) : 0.02;
    spinY += (morphing || state === "wheel" ? -spinY * 1.5 * dt : dt * 0.14);
    spinZ += (state === "wheel" ? dt * 0.0523 : -spinZ * 1.5 * dt);
    tiltX += (tgtTX - tiltX) * Math.min(1, dt * 4);
    offY += (tgtOY - offY) * Math.min(1, dt * 4);
    beatV *= Math.pow(0.02, dt);
    const breathe = 1 + Math.sin(t * 0.84) * 0.012;
    const P = frameBuf;
    const breathR = breathe - 1;
    for (let i = 0; i < N; i++) {
      const j = i * 3, r = aRnd[i];
      const fx = aFrom[j], fy = aFrom[j+1], fz = aFrom[j+2];
      const tx = aTo[j], ty = aTo[j+1], tz = aTo[j+2];
      const k = morphing ? e : 1;
      const nx = Math.sin(t * (0.6 + r) + r * 40.0) * turb;
      const ny = Math.cos(t * (0.5 + r * 0.8) + r * 31.0) * turb;
      const nz = Math.sin(t * (0.7 + r * 0.5) + r * 57.0) * turb * 0.5;
      const b = 1 + breathR * (0.5 + r * 0.5);
      P[j]   = (fx + (tx - fx) * k + nx) * b;
      P[j+1] = (fy + (ty - fy) * k + ny) * b;
      P[j+2] = (fz + (tz - fz) * k + nz) * b;
    }
    if (morphing && mixV >= 1) { aFrom = aTo; }
    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT);
    gl.useProgram(prog);
    gl.uniform1f(loc.uRX, tiltX);
    gl.uniform1f(loc.uRY, spinY + offY);
    gl.uniform1f(loc.uRZ, spinZ);
    gl.uniform1f(loc.uAspect, gl.canvas.height / gl.canvas.width);
    gl.uniform1f(loc.uTime, t);
    gl.uniform1f(loc.uBeat, Math.min(1, beatV));
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, P, gl.DYNAMIC_DRAW);
    gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 12, 0);
    gl.enableVertexAttribArray(0);
    gl.bindBuffer(gl.ARRAY_BUFFER, rndBuf);
    gl.vertexAttribPointer(1, 1, gl.FLOAT, false, 4, 0);
    gl.enableVertexAttribArray(1);
    gl.drawArrays(gl.POINTS, 0, N);
  }
  function setTarget(s) {
    if (!ok || s === state) return;
    state = s;
    aFrom = mixCurrent();
    aTo = s === "wheel" ? wheelT : cubeT;
    mixV = 0; morphT0 = performance.now(); morphing = true;
  }
  let curBuf = null;
  function mixCurrent() {
    const out = new Float32Array(N * 3);
    const e = morphing ? mixV : 1;
    for (let i = 0; i < N * 3; i++) out[i] = aFrom[i] + (aTo[i] - aFrom[i]) * e;
    return out;
  }
  function pulse() { if (ok) beatV = 1; }
  function setTilt(tx, oy) { tgtTX = -0.08 + tx; tgtOY = oy; }
  
function coverFor(n){
var hue=(n*137.508)%360;
var svg='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1 1"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl('+hue+',60%,15%)"/><stop offset="1" stop-color="hsl('+((hue+40)%360)+',80%,45%)"/></linearGradient></defs><rect width="1" height="1" fill="url(#g)"/></svg>';
return "data:image/svg+xml;utf8,"+encodeURIComponent(svg);
}

  function init() {
    try {
      const cv = document.getElementById("gl");
      gl = cv.getContext("webgl2", { alpha: true, antialias: false, premultipliedAlpha: false });
      if (!gl) return;
      prog = gl.createProgram();
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
      loc.uRX = gl.getUniformLocation(prog, "uRX");
      loc.uRY = gl.getUniformLocation(prog, "uRY");
      loc.uRZ = gl.getUniformLocation(prog, "uRZ");
      loc.uAspect = gl.getUniformLocation(prog, "uAspect");
      loc.uTime = gl.getUniformLocation(prog, "uTime");
      loc.uBeat = gl.getUniformLocation(prog, "uBeat");
      buf = gl.createBuffer();
      rndBuf = gl.createBuffer();
      frameBuf = new Float32Array(N * 3);
      cubeT = genCube(); wheelT = genWheel();
      aRnd = new Float32Array(N);
      for (let i = 0; i < N; i++) aRnd[i] = Math.random();
      aFrom = cubeT; aTo = cubeT;
      gl.bindBuffer(gl.ARRAY_BUFFER, rndBuf);
      gl.bufferData(gl.ARRAY_BUFFER, aRnd, gl.STATIC_DRAW);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.SRC_ALPHA, gl.ONE);
      gl.disable(gl.DEPTH_TEST);
      ok = true;
      lastT = performance.now();
      raf = requestAnimationFrame(frame);
    } catch (e) { ok = false; }
  }
  return { init, setTarget, pulse, setTilt, isOk: () => ok };

  if (document.fonts) {
    ["Unbounded Var", "Manrope Var", "JetBrains Mono Var", "Golos Text Var"].forEach(function(f) {
      document.fonts.load("1em " + f).catch(function(){});
    });
  }

var _prefersReduced=window.matchMedia("(prefers-reduced-motion: reduce)");
function _onMotionChange(e){
if(e.matches){
root.dataset.motion="off";
if(typeof raf!=="undefined"&&raf)cancelAnimationFrame(raf);
}else{
root.dataset.motion="on";
if(typeof init!=="function")return;
}
}
if(_prefersReduced.addEventListener)_prefersReduced.addEventListener("change",_onMotionChange);
else if(_prefersReduced.addListener)_prefersReduced.addListener(_onMotionChange);
_onMotionChange(_prefersReduced);

window.addEventListener("hashchange",function(){
var m=(location.hash||"").match(/^#\/t(\d{1,2})$/);
if(m){
var idx=TRACKS.findIndex(function(t){return t.i===m[1].padStart(2,"0");});
if(idx>=0){enterWheel();openTrack(idx);}
}else if(location.hash==="#/wheel"){enterWheel();}
else if(location.hash==="#/grid"){if(typeof prevMode!=="undefined"){prevMode="cube";}setMode("grid");}
});

var _canvas=document.querySelector("canvas");
if(_canvas){
_canvas.addEventListener("webglcontextlost",function(e){e.preventDefault();if(typeof raf!=="undefined"&&raf)cancelAnimationFrame(raf);},false);
_canvas.addEventListener("webglcontextrestored",function(){if(typeof init==="function")init();},false);
}


var repeatMode = false;
var shuffleMode = false;
var btnRepeat = document.getElementById("btnRepeat");
var btnShuffle = document.getElementById("btnShuffle");
if (btnRepeat) btnRepeat.addEventListener("click", function(){
  repeatMode = !repeatMode;
  btnRepeat.setAttribute("aria-pressed", String(repeatMode));
  btnRepeat.style.color = repeatMode ? "var(--primary)" : "";
});
if (btnShuffle) btnShuffle.addEventListener("click", function(){
  shuffleMode = !shuffleMode;
  btnShuffle.setAttribute("aria-pressed", String(shuffleMode));
  btnShuffle.style.color = shuffleMode ? "var(--primary)" : "";
});

var sAudioEl = document.getElementById("sAudio");
if (sAudioEl) {
  sAudioEl.addEventListener("ended", function(){
    if (repeatMode) {
      sAudioEl.currentTime = 0;
      sAudioEl.play();
    } else if (shuffleMode) {
      var next = Math.floor(Math.random() * (window.TRACKS || TRACKS).length);
      openTrack(next);
      setTimeout(function(){ startPulse(); }, 300);
    } else {
      var nextIdx = (activeIdx + 1) % (window.TRACKS || TRACKS).length;
      openTrack(nextIdx);
      setTimeout(function(){ startPulse(); }, 300);
    }
  });
}

var oldBtnNextClick = document.getElementById("btnNext");
if (oldBtnNextClick) {
  oldBtnNextClick.addEventListener("click", function(){
    var next;
    if (shuffleMode) {
      next = Math.floor(Math.random() * (window.TRACKS || TRACKS).length);
    } else {
      next = (activeIdx + 1) % (window.TRACKS || TRACKS).length;
    }
    openTrack(next);
  });
}
var oldBtnPrevClick = document.getElementById("btnPrev");
if (oldBtnPrevClick) {
  oldBtnPrevClick.addEventListener("click", function(){
    var prev = (activeIdx - 1 + (window.TRACKS || TRACKS).length) % (window.TRACKS || TRACKS).length;
    openTrack(prev);
  });
}


var btnPlayEl = document.getElementById("btnPlay");
if (btnPlayEl && !btnPlayEl._bound) {
  btnPlayEl._bound = true;
  btnPlayEl.addEventListener("click", function(){
    if (panel.classList.contains("is-playing")) {
      stopPulse();
    } else {
      startPulse();
    }
  });
}

})();

const stage = document.getElementById("stage");
const cubeWrap = document.getElementById("cubeWrap");
const cube = document.getElementById("cube");
const wheel = document.getElementById("wheel");
const wheelInner = document.getElementById("wheelInner");
const rotator = document.getElementById("rotator");
const axis = document.getElementById("axis");
const panel = document.getElementById("panel");
const pNum = document.getElementById("pNum");
const pState = document.getElementById("pState");
const pTitle = document.getElementById("pTitle");
const kLines = document.getElementById("kLines");
const kFull = document.getElementById("kFull");
const kBar = document.getElementById("kBar");
const btnPlay = document.getElementById("btnPlay");
const btnPrev = document.getElementById("btnPrev");
const btnNext = document.getElementById("btnNext");
const btnMode = document.getElementById("btnMode");
const btnShare = document.getElementById("btnShare");
const btnClose = document.getElementById("btnClose");
const btnReset = document.getElementById("btnReset");
const btnMotion = document.getElementById("btnMotion");
const btnGrid = document.getElementById("btnGrid");
const btnRandom = document.getElementById("btnRandom");
const btnHelp = document.getElementById("btnHelp");
const helpDlg = document.getElementById("help");
const gridView = document.getElementById("gridView");
const gridEl = document.getElementById("grid");
const searchEl = document.getElementById("search");
const foundEl = document.getElementById("found");
const counterEl = document.getElementById("counter");
const toastEl = document.getElementById("toast");
const volEl = document.getElementById("vol");
const vizEl = document.getElementById("viz");
const pVec = document.getElementById("pVec");
const root = document.documentElement;

const N = TRACKS.length;
const RING_BOX = [34, 27.75, 21.5, 15.25, 9];
const RING_NAMES = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX"];
const STATE_LABEL = { text: "текст", shum: "шум", gip: "гибрид" };
let mode = "cube";
let prevMode = "cube";
let activeIdx = -1;
let lines = [];
let lineIdx = 0;
let lineTimer = null;
let fullMode = false;
let heard = new Set();
try { heard = new Set(JSON.parse(localStorage.getItem("kub26_heard_v2") || "[]")); } catch (e) {}
function saveHeard() {
  try { localStorage.setItem("kub26_heard_v2", JSON.stringify([...heard])); } catch (e) {}
}

(function buildCube() {
  document.querySelectorAll(".face").forEach((face) => {
    const frag = document.createDocumentFragment();
    for (let i = 0; i < N; i++) {
      const c = document.createElement("div");
      c.className = "cell";
      var target = document.createElement("div"); target.className = "cell-num"; target.textContent = String(i + 1).padStart(2, "0"); c.appendChild(target); c.title = String(i + 1).padStart(2, "0");
      frag.appendChild(c);
    }
    face.appendChild(frag);
  });
})();

(function buildWheel() {

  const diams = [72, 68, 55.5, 43, 30.5, 18];
  diams.forEach((d, k) => {
    const g = document.createElement("div");
    g.className = "ring-guide" + (k === 0 ? " rim" : "");
    g.style.width = d + "%";
    wheelInner.insertBefore(g, rotator);
  });
  const frag = document.createDocumentFragment();

  for (let s = 0; s < 12; s++) {
    const sp = document.createElement("div");
    sp.className = "spoke";
    sp.style.transform = "rotate(" + (s * 30 - 180) + "deg)";
    frag.appendChild(sp);
  }

  TRACKS.forEach((t, i) => {
    const ring = Math.floor(i / 12);
    const pos = i % 12;
    const phi = pos * 30;
    const rad = phi * Math.PI / 180;
    const r = RING_BOX[ring];
    const x = 50 + r * Math.cos(rad);
    const y = 50 + r * Math.sin(rad);
    const node = document.createElement("button");
    node.type = "button";
    node.className = "node n-r" + ring + (heard.has(Number(t.i)) ? " is-heard" : "");
    node.dataset.i = i;
    node.dataset.s = t.s;
    node.setAttribute("aria-label", t.i + " · " + t.t + " · " + STATE_LABEL[t.s]);
    node.innerHTML = "<span>" + t.i + "</span>";
    node.style.left = x + "%";
    node.style.top = y + "%";
    node.addEventListener("click", (e) => { e.stopPropagation(); openTrack(i); });
    frag.appendChild(node);
  });
  rotator.appendChild(frag);
})();

(function buildGrid() {
  const frag = document.createDocumentFragment();
  TRACKS.forEach((t, i) => {
    const card = document.createElement("button");
    card.type = "button";
    card.className = "card" + (heard.has(Number(t.i)) ? " is-heard" : "");
    card.setAttribute("role", "listitem");
    card.dataset.i = i;
    card.dataset.s = t.s;
    card.dataset.hay = (t.t + " " + (t.l || "")).toLowerCase();
    card.setAttribute("role", "listitem");
    card.innerHTML =
      '<span class="c-num">' + t.i + " · " + RING_NAMES[Math.min(Math.floor(i / 12), RING_NAMES.length - 1)] + "</span>" +
      '<span class="c-title"></span>' +
      '<span class="c-state">' + STATE_LABEL[t.s] + "</span>";
    card.querySelector(".c-title").textContent = t.t;
    card.addEventListener("click", () => openTrack(i));
    frag.appendChild(card);
  });
  gridEl.appendChild(frag);
})();
searchEl.addEventListener("input", () => {
  const q = searchEl.value.trim().toLowerCase();
  let vis = 0;
  gridEl.querySelectorAll(".card").forEach((card) => {
    const show = !q || card.dataset.hay.includes(q);
    card.style.display = show ? "" : "none";
    if (show) vis++;
  });
  foundEl.textContent = String(vis);
});

function setMode(m) {
  mode = m;
  Dust.setTarget(m === "cube" ? "cube" : "wheel");
  document.body.classList.toggle("mode-wheel", m === "wheel");
  document.body.classList.toggle("mode-grid", m === "grid");
  stage.classList.toggle("is-wheel", m === "wheel");
  stage.classList.toggle("is-grid", m === "grid");
  cubeWrap.classList.toggle("is-axis", m !== "cube");
  wheel.setAttribute("aria-hidden", m === "wheel" ? "false" : "true");
  gridView.setAttribute("aria-hidden", m === "grid" ? "false" : "true");
  btnReset.hidden = m === "cube";
  btnGrid.setAttribute("aria-pressed", m === "grid" ? "true" : "false");
  if (m === "cube") {
    if (location.hash && location.hash !== "#") history.replaceState(null, "", location.pathname + location.search);
  } else {
    const target = "#/" + (m === "wheel" ? "wheel" : "grid");
    if (location.hash !== target) history.replaceState(null, "", target);
  }
}
function enterWheel() { if (mode !== "wheel") { prevMode = "wheel"; setMode("wheel"); } }
function backToCube() { closePanel(); setMode("cube"); }
cubeWrap.addEventListener("click", enterWheel);
cubeWrap.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " ") { e.preventDefault(); enterWheel(); }
});
axis.addEventListener("click", (e) => {
  e.stopPropagation();
  const on = root.dataset.motion !== "off";
  root.dataset.motion = on ? "off" : "on";
  btnMotion.setAttribute("aria-pressed", root.dataset.motion === "on");
  showToast(on ? "движение выключено" : "движение включено");
});
axis.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " ") { e.preventDefault(); axis.click(); }
});
btnReset.addEventListener("click", backToCube);
btnGrid.addEventListener("click", () => {
  if (mode === "grid") { setMode(prevMode === "wheel" ? "wheel" : "cube"); }
  else { prevMode = mode === "wheel" ? "wheel" : "cube"; setMode("grid"); }
});
btnMotion.addEventListener("click", () => {
  const on = root.dataset.motion !== "off";
  root.dataset.motion = on ? "off" : "on";
  btnMotion.setAttribute("aria-pressed", root.dataset.motion === "on");
});
btnHelp.addEventListener("click", () => { try { helpDlg.showModal(); } catch (e) {} });
document.getElementById("helpClose").addEventListener("click", () => helpDlg.close());
btnRandom.addEventListener("click", () => {
  let r = Math.floor(Math.random() * N);
  if (N > 1 && r === activeIdx) r = (r + 1 + Math.floor(Math.random() * (N - 1))) % N;
  if (mode === "cube") enterWheel();
  openTrack(r);
});

function parseLyrics(t) {
  const _src = (t.l && String(t.l).trim()) ? t.l : "";
  if (!_src) return [{ chip: true, aside: false, text: "текст не добавлен" }, { chip: false, aside: false, text: t.t }];
  const raw = _src.split(/\n+/).map((s) => s.trim()).filter(Boolean);
  if (!raw.length) return [{ chip: true, aside: false, text: "текст не добавлен" }, { chip: false, aside: false, text: t.t }];
  return raw.map((s) => ({
    chip: /^\[[^\]]+\]$/.test(s),
    aside: s.startsWith("—"),
    text: s.replace(/^\[|\]$/g, ""),
  }));
}
function lineDur(text) {
  return Math.min(6800, Math.max(1900, 1500 + text.length * 62));
}

const vizCtx = vizEl.getContext("2d");
let vizRaf = null;
function sizeViz() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  vizEl.width = Math.max(1, Math.round(vizEl.clientWidth * dpr));
  vizEl.height = Math.max(1, Math.round(vizEl.clientHeight * dpr));
}
function drawVizFlat() {
  sizeViz();
  var w = vizEl.width, h = vizEl.height;
  vizCtx.clearRect(0, 0, w, h);
  vizCtx.fillStyle = "rgba(255,171,64,0.28)";
  const bars = 32, gap = Math.max(1, w * 0.004);
  const bw = (w - gap * (bars - 1)) / bars;
  for (let i = 0; i < bars; i++) {
    const bh = h * 0.18;
    vizCtx.fillRect(i * (bw + gap), h - bh, bw, bh);
  }
}
function vizLoop() {
  var an = null;
  var sAudio = document.getElementById("sAudio");
  if (sAudio && !sAudio.paused && window._realAnalyser) {
    an = window._realAnalyser;
  }
  if (!an) return;
  const data = new Uint8Array(an.frequencyBinCount);
  var w = vizEl.width, h = vizEl.height;
  var w = vizEl.width, h = vizEl.height;
  vizCtx.clearRect(0, 0, w, h);
  an.getByteFrequencyData(data);
  const bars = 32, gap = Math.max(1, w * 0.004);
  const bw = (w - gap * (bars - 1)) / bars;
  for (let i = 0; i < bars; i++) {
    const v = data[i] / 255;
    const bh = Math.max(h * 0.06, v * h);
    const grad = vizCtx.createLinearGradient(0, h - bh, 0, h);
    grad.addColorStop(0, "rgba(255,171,64,0.95)");
    grad.addColorStop(1, "rgba(196,92,38,0.55)");
    vizCtx.fillStyle = grad;
    vizCtx.fillRect(i * (bw + gap), h - bh, bw, bh);
  }
  vizRaf = requestAnimationFrame(vizLoop);
}

function stopPulse() {
  if (lineTimer) { clearTimeout(lineTimer); lineTimer = null; }
  var sAudio = document.getElementById("sAudio");
  if (sAudio) { try { sAudio.pause(); } catch(e) {} }
  if (typeof Clock !== "undefined" && Clock) { try { Clock.pause(); } catch(e) {} }
  if (vizRaf) { cancelAnimationFrame(vizRaf); vizRaf = null; }
  panel.classList.remove("is-playing");
  var btnPlay = document.getElementById("btnPlay");
  if (btnPlay) { btnPlay.setAttribute("aria-pressed", "false"); btnPlay.textContent = "\u25b6"; }
  if (typeof drawVizFlat === "function") drawVizFlat();
}
function renderLines() {
  if (!lines.length) return;
  const prev = lines[(lineIdx - 1 + lines.length) % lines.length];
  const cur = lines[lineIdx];
  const next = lines[(lineIdx + 1) % lines.length];
  const mk = (it, cls) =>
    '<div class="' + (it.chip ? "k-chip" : "k-line") + " " + cls + '">' +
    (it.text || "") + "</div>";
  kLines.innerHTML = mk(prev, "is-prev") + mk(cur, "is-active") + mk(next, "is-next");

  const dur = lineDur(cur.text);
  kBar.style.transition = "none";
  kBar.style.width = "0%";
  void kBar.offsetWidth;
  kBar.style.transition = "width " + dur + "ms linear";
  kBar.style.width = "100%";
}
function scheduleNext() {
  if (lineTimer) clearTimeout(lineTimer);
  const cur = lines[lineIdx];
  lineTimer = setTimeout(() => {
    lineIdx = (lineIdx + 1) % lines.length;
    renderLines();
    scheduleNext();
  }, lineDur(cur.text));
}
function startPulse() {
  stopPulse();
  if (!lines.length || activeIdx < 0) return;
  panel.classList.add("is-playing");
  var btnPlay = document.getElementById("btnPlay");
  if (btnPlay) { btnPlay.setAttribute("aria-pressed", "true"); btnPlay.textContent = "\u25a0"; }
  var sAudio = document.getElementById("sAudio");
  if (sAudio && sAudio.src) {
    try {
      if (window._fftAC && window._fftAC.state === "suspended") window._fftAC.resume();
      sAudio.play();
    } catch(e) {}
  }
  if (typeof Clock !== "undefined" && Clock) {
    Clock.el = sAudio;
    Clock.mode = (sAudio && sAudio.src) ? "file" : "demo";
    Clock.play();
  }
  if (typeof sizeViz === "function") sizeViz();
  if (vizRaf) cancelAnimationFrame(vizRaf);
  vizRaf = requestAnimationFrame(vizLoop);
  lineIdx = 0;
  if (typeof renderLines === "function") renderLines();
  if (typeof scheduleNext === "function") scheduleNext();
}
function renderFull() {
  kFull.innerHTML = lines.map((it, k) => {
    const cls = it.chip ? "f-chip" : "f-line" + (it.aside ? " is-aside" : "");
    const cur = k === lineIdx ? " is-current" : "";
    return '<div class="' + cls + cur + '" data-k="' + k + '">' + (it.text || "") + "</div>";
  }).join("");
}
kFull.addEventListener("click", (e) => {
  var el = e.target.closest(".f-line");
  if (!el) return;
  lineIdx = Number(el.dataset.k);
  renderFull();
  scheduleNext();
});
btnPlay.addEventListener("click", function() {
  if (panel.classList.contains("is-playing")) stopPulse();
  else startPulse();
});
volEl.addEventListener("input", () => {  });
btnMode.addEventListener("click", () => {
  if (activeIdx < 0) { if (typeof showToast === "function") showToast("сначала выберите трек"); return; }
  fullMode = !fullMode;
  kFull.hidden = !fullMode;
  kLines.style.display = fullMode ? "none" : "";
  btnMode.textContent = fullMode ? "караоке" : "весь текст";
  if (fullMode) renderFull();
  else { drawVizFlat(); }
});
function updateCounter() {
  counterEl.textContent = heard.size + "/" + N;
}
function showToast(msg) {
  toastEl.textContent = msg;
  toastEl.classList.add("show");
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => toastEl.classList.remove("show"), 1900);
}
function openTrack(i) {
  activeIdx = i;
  var t = window.TRACKS ? window.TRACKS[i] : TRACKS[i];
  if (mode === "cube") enterWheel();
  document.querySelectorAll(".node.is-active, .card.is-active").forEach(function(n){ n.classList.remove("is-active"); });
  var nodeEl = document.querySelector('.node[data-i="' + i + '"]');
  if (nodeEl) nodeEl.classList.add("is-active");
  var cardEl = document.querySelector('.card[data-i="' + i + '"]');
  if (cardEl) cardEl.classList.add("is-active");
  
  var pNum = document.getElementById("pNum");
  var pTitle = document.getElementById("pTitle");
  var pState = document.getElementById("pState");
  var pVec = document.getElementById("pVec");
  if (pNum) pNum.textContent = t.i + " / " + N;
  if (pState) { var _ai = parseInt(t.i, 10); var _lb = (STATE_LABEL[t.s] || t.s); if (window.TRACK_AUDIO && TRACK_AUDIO[_ai] && typeof TRACK_PREVIEW !== "undefined" && TRACK_PREVIEW[_ai]) _lb += " · превью 30 с"; else if (window.TRACK_AUDIO && TRACK_AUDIO[_ai]) _lb += " · полный";_lb += " · полный"; if (window.TRACK_HINT && TRACK_HINT[_ai]) _lb += " · аудио не сверено"; pState.textContent = _lb; }
  if (pTitle) pTitle.textContent = t.t;
  if (pVec) pVec.textContent = (window.VEC_BY_TITLE && VEC_BY_TITLE[t.t]) || "";

  lines = parseLyrics(t);
  lineIdx = 0;
  fullMode = false;
  var kFull = document.getElementById("kFull");
  var kLines = document.getElementById("kLines");
  if (kFull) kFull.hidden = true;
  if (kLines) kLines.style.display = "";
  var btnMode = document.getElementById("btnMode");
  if (btnMode) btnMode.textContent = "весь текст";
  if (typeof renderLines === "function") renderLines();
  stopPulse();
  
  panel.classList.add("open");
  panel.scrollIntoView({behavior:"smooth",block:"end"});
  panel.removeAttribute("inert");
  panel.setAttribute("aria-hidden", "false");

  var sAudio = document.getElementById("sAudio");
  if (sAudio) {
    try { sAudio.pause(); sAudio.currentTime = 0; } catch(e) {}
    var idx = parseInt(t.i, 10);
    if (window.TRACK_AUDIO && TRACK_AUDIO[idx]) {
      sAudio.src = TRACK_AUDIO[idx];
      sAudio.load();
      if (typeof initFFT === "function") initFFT(sAudio);
      sAudio.hidden = false;
      var playBtn = document.getElementById("btnPlay");
      if (playBtn) playBtn.style.display = "";
    } else {
      sAudio.removeAttribute("src");
      sAudio.hidden = true;
      var playBtn = document.getElementById("btnPlay");
      if (playBtn) playBtn.style.display = "none";
    }
  }

  if (!heard.has(Number(t.i))) {
    heard.add(Number(t.i));
    if (typeof saveHeard === "function") saveHeard();
    if (nodeEl) nodeEl.classList.add("is-heard");
    if (cardEl) cardEl.classList.add("is-heard");
    if (typeof updateCounter === "function") updateCounter();
  }
  history.replaceState(null, "", "#/t" + t.i);

  if (typeof Clock !== "undefined" && Clock) {
    try {
      Clock.el = sAudio;
      Clock.mode = (sAudio && sAudio.src) ? "file" : "demo";
      Clock.dur = 30;
      Clock.fPos = 0;
    } catch(e) {}
  }
}
function closePanel() {
  stopPulse();
  var sAudio = document.getElementById("sAudio");
  if (sAudio) { try { sAudio.pause(); sAudio.currentTime = 0; } catch(e) {} }
  panel.classList.remove("open");
  panel.setAttribute("aria-hidden", "true");
  panel.setAttribute("inert", "");
  document.querySelectorAll(".node.is-active, .card.is-active").forEach((n) => n.classList.remove("is-active"));
  activeIdx = -1;
  if (mode !== "cube") history.replaceState(null, "", "#/" + (mode === "wheel" ? "wheel" : "grid"));
}
btnClose.addEventListener("click", closePanel);
btnPrev.addEventListener("click", () => openTrack((activeIdx - 1 + N) % N));
btnNext.addEventListener("click", () => openTrack((activeIdx + 1) % N));
btnShare.addEventListener("click", async () => {
  const url = location.origin && location.origin !== "null"
    ? location.href
    : location.hash || "#/t" + (TRACKS[activeIdx] ? TRACKS[activeIdx].i : "01");
  const shareData = {
    title: "КУБ-2026 · " + (TRACKS[activeIdx] ? TRACKS[activeIdx].t : ""),
    url,
  };
  try {
    if (navigator.share) { await navigator.share(shareData); return; }
    await navigator.clipboard.writeText(url);
    showToast("ссылка скопирована");
  } catch (e) {
    showToast("не удалось поделиться");
  }
});

document.addEventListener("keydown", (e) => {
  const tag = (e.target && e.target.tagName) || "";
  if (tag === "INPUT" || tag === "TEXTAREA") return;
  if (helpDlg.open && e.key !== "Escape") return;
  if (e.key === "Escape") {
    if (panel.classList.contains("open")) closePanel();
    else if (mode !== "cube") backToCube();
    return;
  }
  if (panel.classList.contains("open") && e.key === "ArrowLeft") { openTrack((activeIdx - 1 + N) % N); return; }
  if (panel.classList.contains("open") && e.key === "ArrowRight") { openTrack((activeIdx + 1) % N); return; }
  const k = e.key.toLowerCase();
  if (k === "r" || k === "к") { btnRandom.click(); return; }
  if (k === "g" || k === "п") { btnGrid.click(); return; }
  if (k === "m" || k === "ь") { btnMotion.click(); }
});

(function emberField() {
  const cv = document.getElementById("fx");
  const c2 = cv.getContext("2d");
  let W = 0, H = 0, parts = [];
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  function resize() {
    W = window.innerWidth; H = window.innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    c2.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function seed() {
    parts = [];
    const count = Math.min(90, Math.round(W * H / 22000));
    for (let i = 0; i < count; i++) {
      parts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 0.5 + Math.random() * 1.4,
        vy: 0.12 + Math.random() * 0.4,
        sw: 0.4 + Math.random() * 1.1,
        ph: Math.random() * Math.PI * 2,
        a: 0.08 + Math.random() * 0.3,
      });
    }
  }
  function tick() {
    var i, p, x, y;
    if (root.dataset.motion !== "off" && !document.hidden) {
      c2.clearRect(0, 0, W, H);
      c2.globalCompositeOperation = "lighter";
      for (const p of parts) {
        p.y -= p.vy;
        p.ph += 0.008;
        if (p.y < -6) { p.y = H + 6; p.x = Math.random() * W; }
        const x = p.x + Math.sin(p.ph) * p.sw * 22;
        c2.beginPath();
        c2.fillStyle = "rgba(255,171,64," + p.a + ")";
        c2.arc(x, p.y, p.r, 0, Math.PI * 2);
        c2.fill();
      }
      c2.globalCompositeOperation = "source-over";
    }
    requestAnimationFrame(tick);
  }
  window.addEventListener("resize", () => { resize(); seed(); });
  resize(); seed();
  if (root.dataset.motion !== "off") tick();
  else requestAnimationFrame(tick);
})();

  var _fftAC = null, _fftSrc = null, _fftAnal = null;
  function initFFT(audioEl) {
    if (_fftAnal) return _fftAnal;
    try {
      _fftAC = new (window.AudioContext || window.webkitAudioContext)();
      _fftSrc = _fftAC.createMediaElementSource(audioEl);
      _fftAnal = _fftAC.createAnalyser();
      _fftAnal.fftSize = 64;
      _fftSrc.connect(_fftAnal);
      _fftAnal.connect(_fftAC.destination);
      window._realAnalyser = _fftAnal;
      return _fftAnal;
    } catch(e) { return null; }
  }

(function init() {
  updateCounter();
  drawVizFlat();

  Dust.init();
  if (Dust.isOk()) root.classList.add("gl-on");

  document.addEventListener("samsara-beat", () => {
    Dust.pulse();
    axis.classList.add("on-beat");
    clearTimeout(init._bt);
    init._bt = setTimeout(() => axis.classList.remove("on-beat"), 140);
  });

  window.addEventListener("pointermove", (e) => {
    Dust.setTilt((e.clientY / window.innerHeight - 0.5) * 0.5, (e.clientX / window.innerWidth - 0.5) * 0.55);
  }, { passive: true });

  window.addEventListener("deviceorientation", (e) => {
    if (e.beta == null || e.gamma == null) return;
    Dust.setTilt(Math.max(-0.4, Math.min(0.4, (e.beta - 45) / 120)), Math.max(-0.5, Math.min(0.5, e.gamma / 90)));
  }, { passive: true });

  try {
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.dataset.motion = "off";
      btnMotion.setAttribute("aria-pressed", "false");
    }
  } catch (e) {}

  const m = (location.hash || "").match(new RegExp("^#/t(\\d{1,2})"));
  if (m) {
    const idx = TRACKS.findIndex((t) => t.i === m[1].padStart(2, "0"));
    if (idx >= 0) { enterWheel(); openTrack(idx); return; }
  }
  if (location.hash === "#/wheel") enterWheel();
  else if (location.hash === "#/grid") { prevMode = "cube"; setMode("grid"); }
})();

window.addEventListener("hashchange", () => {
  const hm = (location.hash || "").match(new RegExp("^#/t(\\d{1,2})"));
  if (hm) {
    const idx = TRACKS.findIndex((t) => t.i === hm[1].padStart(2, "0"));
    if (idx >= 0 && idx !== activeIdx) { enterWheel(); openTrack(idx); }
    return;
  }
  if (location.hash === "#/wheel" && mode !== "wheel") setMode("wheel");
  else if (location.hash === "#/grid" && mode !== "grid") { prevMode = "cube"; setMode("grid"); }
  else if (!location.hash || location.hash === "#/") { if (mode !== "cube") setMode("cube"); }
});


</script>








<script>
/* === RUVSON QUANTUM · transport fix (repeat / shuffle / ended / prev / next) === */
(function () {
  var repeatMode = false;
  var shuffleMode = false;

  var btnRepeat = document.getElementById("btnRepeat");
  var btnShuffle = document.getElementById("btnShuffle");
  var btnPrev = document.getElementById("btnPrev");
  var btnNext = document.getElementById("btnNext");
  var sAudio = document.getElementById("sAudio");

  function applyToggle(btn, on) {
    if (!btn) return;
    btn.setAttribute("aria-pressed", String(on));
    btn.style.color = on ? "var(--primary, #ffab40)" : "";
    btn.classList.toggle("is-on", on);
  }

  if (btnRepeat) {
    btnRepeat.addEventListener("click", function () {
      repeatMode = !repeatMode;
      if (repeatMode && shuffleMode) {
        shuffleMode = false;
        applyToggle(btnShuffle, false);
      }
      applyToggle(btnRepeat, repeatMode);
    });
  }
  if (btnShuffle) {
    btnShuffle.addEventListener("click", function () {
      shuffleMode = !shuffleMode;
      if (shuffleMode && repeatMode) {
        repeatMode = false;
        applyToggle(btnRepeat, false);
      }
      applyToggle(btnShuffle, shuffleMode);
    });
  }

  function trackCount() {
    return (window.TRACKS || (typeof TRACKS !== "undefined" ? TRACKS : [])).length || 0;
  }

  function pickNextIdx() {
    var n = trackCount();
    if (n <= 0) return -1;
    if (shuffleMode) {
      if (n === 1) return 0;
      var r;
      do { r = Math.floor(Math.random() * n); } while (r === activeIdx);
      return r;
    }
    return ((activeIdx + 1) % n + n) % n;
  }

  function pickPrevIdx() {
    var n = trackCount();
    if (n <= 0) return -1;
    if (shuffleMode) {
      if (n === 1) return 0;
      var r;
      do { r = Math.floor(Math.random() * n); } while (r === activeIdx);
      return r;
    }
    return ((activeIdx - 1) % n + n) % n;
  }

  if (sAudio) {
    sAudio.addEventListener("ended", function () {
      if (repeatMode) {
        try { sAudio.currentTime = 0; sAudio.play(); } catch (e) {}
        return;
      }
      var next = pickNextIdx();
      if (next < 0) return;
      if (typeof openTrack === "function") {
        openTrack(next);
        setTimeout(function () {
          if (typeof startPulse === "function") {
            try { startPulse(); } catch (e) {}
          }
        }, 250);
      }
    });
  }

  /* Replace existing prev/next behavior with shuffle-aware versions.
     We stop the original handlers from firing by cloning the nodes. */
  function rebindNav(btn, picker) {
    if (!btn) return;
    var clone = btn.cloneNode(true);
    btn.parentNode.replaceChild(clone, btn);
    clone.addEventListener("click", function () {
      var idx = picker();
      if (idx < 0) return;
      if (typeof openTrack === "function") {
        openTrack(idx);
        /* keep playing state if currently playing */
        if (document.getElementById("panel") && document.getElementById("panel").classList.contains("is-playing")) {
          setTimeout(function () {
            if (typeof startPulse === "function") {
              try { startPulse(); } catch (e) {}
            }
          }, 200);
        }
      }
    });
    return clone;
  }

  var newNext = rebindNav(btnNext, pickNextIdx);
  var newPrev = rebindNav(btnPrev, pickPrevIdx);
  /* update references for any other code that grabbed them by id later — they re-query getElementById so fine */

  /* expose state for debugging */
  window.__ruvsonTransport = {
    get repeat() { return repeatMode; },
    get shuffle() { return shuffleMode; },
    setRepeat: function (v) { repeatMode = !!v; applyToggle(btnRepeat, repeatMode); },
    setShuffle: function (v) { shuffleMode = !!v; applyToggle(btnShuffle, shuffleMode); }
  };
})();
</script>

</body>
</html>
