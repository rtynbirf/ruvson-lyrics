<!-- V5 JS removed — karaoke engine from v3 is active -->
<script>
if(document.fonts){["Unbounded Var","Manrope Var","JetBrains Mono Var","Golos Text Var"].forEach(function(f){document.fonts.load("bold 1em "+f).catch(function(){});document.fonts.load("normal 1em "+f).catch(function(){});document.fonts.load("italic 1em "+f).catch(function(){});});}

"use strict";
window.TRACKS = [{"i": "1", "t": "Где настоящее", "s": "text", "l": "[Куплет 1]\nНу что ж, это прогресс:\nСтроить нейросети, база на Марсе,\nЖить в метавселенной в бесконечном трансе,\nВключать вечный май одним свайпом по экрану,\nПолучать всё и сразу. Мы это можем.\n\nДа, мы дошли до предела желаний,\nВ мире без пауз и без расстояний.\nВсё стало ближе, быстрее и доступнее,\nНо почему-то внутри стало глуше.\n\n[Припев]\nМы летим всё быстрее, меняя пароли,\nМы сами забыли свои же роли.\nНо ответь мне, глядя в этот экран:\nГде теперь настоящее?\nЗдесь или там, где запах дождя,\nГде трава по весне,\nГде настоящее — не только в голове.\nМы знаем почти всё, что можно узнать,\nНо где настоящее?\nГде его искать?\n\n[Куплет 2]\nЗакатали в бетон всё, что пахло весною,\nРади тысяч вещей, что летят к нам домой.\nИ город всё выше, а небо всё темнее.\nМы ищем покой в этом цифровом мире.\nМы меряем жизнь уведомлений числом,\nЗасыпаем с экраном, просыпаемся с ним.\nИ, кажется, нет уже пути для разворота,\nМы просто застряли в петле автопилота.\n\nИ всё вроде правильно. Всё по местам.\nНо почему тишина становится страшной нам?\n\n[Припев]\nМы летим всё быстрее, меняя пароли,\nМы сами забыли свои же роли.\nНо ответь мне, глядя в этот экран:\nГде теперь настоящее?\nЗдесь или там, где запах дождя,\nГде трава по весне,\nГде настоящее не только в голове.\nМы знаем почти всё, что можно узнать,\nНо где настоящее?\nГде его искать?\n\n[Бридж]\nМы пронзили зенит зеркальным стеклом,\nПоднялись выше облаков этажом.\nМы научились стирать расстояния,\nНо не научились стирать одиночество.\nМы можем услышать весь мир за секунду,\nНо всё реже слышим друг друга вокруг.\nМожем создать миллионы миров,\nНе имея одного своего.\n\nА помнишь, как ветер шумел во дворе?\nКак ночь была ночью, а свет фонаря?\nКак время не гнали, как просто молчали,\nИ счастья не нужно было скачивать файлы.\nМожет, дело не в том, что прогресс — это зло?\nМожет, просто всё слишком далеко зашло?\n\n[Припев]\nМы летим всё быстрее, меняя пароли,\nНо кто мы теперь в этой новой роли?\nОтветь мне честно, глядя в экран:\nГде теперь настоящее — здесь или там?\nМы можем весь мир на ладони держать,\nНо где настоящее, где его искать?\n\n[Аутро]\nНо если однажды погаснет экран,\nСкажи мне, где настоящий — здесь или там?"}, {"i": "2", "t": "Свет в темноте", "s": "text", "l": "[Куплет 1]\nКогда часы застыли на стене,\nИ ночь по венам бродит в тишине.\nКогда предел настал и гаснет твой маяк,\nТы не спеши делать последний шаг.\nНе отпускай, слышишь? Не отпускай.\nВедь каждый падал, разбиваясь в прах,\nИ прятал слёзы в высохших глазах.\nВсё идёт не так. Просто выдыхай.\nИз осколков сердце небо собирай.\n\n[Припев]\nМы все разбиты, как хрусталь.\nВ нас болит — значит, мы живы.\nТы не один в этой пустоте.\nМы просто искры в вечной темноте.\n\n[Куплет 2]\nКогда твой день — лишь эхо серых стен,\nИ ты устал от этих перемен.\nДержись, держись.\nЕсли душа кричит: «Я ухожу»,\nСкажи себе: «Я просто подожду».\nПомни: душу лечит только свет.\nПрислушайся, и сердце подскажет тебе ответ.\n\n[Бридж]\nКаждому бывает больно. Да,\nНо это не финал, а лишь начало.\nНе сдавайся, слышишь? О, нет.\nВыход есть, даже если нет примет.\nЕсли кажется, что ты совсем один,\nМы все здесь, за пеленой витрин.\nИз осколков сердце небо собирай.\n\n[Припев]\nМы все разбиты, как хрусталь.\nВ нас болит — значит, мы живы.\nТы не один в этой пустоте.\nМы просто искры в вечной темноте.\n\n[Аутро]\nЕсли мир уходит из-под ног,\nПомни: мы не одни.\nПросто держись.\nДержись."}, {"i": "3", "t": "Цени моменты", "s": "text", "l": "[Куплет 1]\nМы жжём года, не замечаем,\nВсё ищем то, чего всё нет.\nНо жизнь проходит, не прощая,\nИ каждый день оставит след.\nМы всё спешим, всё догоняем,\nТеряя главное в пути.\nПока мы чувствуем и знаем,\nНам есть зачем ещё идти.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь, не заключить с ним договор.\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк.\n\n[Куплет 2]\nМы ставим всё, не зная ставки,\nИ часто платим за урок.\nНо даже после самой давки\nВсегда останется рывок.\nНе жди, когда наступит завтра.\nНе отдавай себя годам.\nПока внутри ещё есть правда,\nТы выбираешь путь свой сам.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь, не заключить с ним договор.\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк.\n\n[Бридж]\nКогда темно — иди вперёд.\nКогда нет сил — ещё живёшь.\nПока внутри огонь не мёртв,\nТы всё равно своё найдёшь.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь…\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк."}, {"i": "4", "t": "А что если да", "s": "text"}, {"i": "5", "t": "Я сам себе враг", "s": "text", "l": "[Куплет 1]\nСтою на дороге старше, чем этот город.\nЯ прячу под улыбкой свой внутренний холод.\nГазеты на лавках кричат о вчерашней войне.\nНо главная битва гремит прямо здесь, во мне.\nЯ видел пророков, торгующих завтрашним днём,\nИ видел тех, кто мечтает пойти на убой.\n\n[Припев]\nЯ сам себе враг, я сам себе брат,\nЯ сам себе суд и сам себе рать.\nВнутри меня двое, и оба чертовски правы:\nОдин хочет жить, а второй — добежать до канавы.\n\n[Куплет 2]\nОдин шепчет: «Брось, это небо сгорело дотла».\nВ карманах дыра, и удача утекла.\nДругой рубит лёд и смеётся в лицо холоду,\nОн ищет дорогу по старым забытым следам.\nИ мы с ними делим один этот старый табак,\nПока за окном догорает небесный маяк.\n\n[Припев]\nЯ сам себе враг. Я сам себе брат.\nЯ сам себе суд. И сам себе рать.\nВнутри меня двое, и оба чертовски правы:\nОдин хочет жить, а второй — добежать до канавы.\n\n[Куплет 3]\nНе спрашивай карту тех, кто сидит взаперти.\nУ них есть ответы, но некуда больше идти.\nЯ ставлю на кон свой последний измятый билет,\nВедь в этой пустыне другого спасения нет.\n\n[Припев]\nЯ сам себе враг. Я сам себе брат.\nЯ сам себе суд. И сам себе рад.\nВнутри меня двое, и оба чертовски правы:\nОдин хочет жить, а второй — добежать до канавы.\n\n[Аутро]\nНо я выбираю каждый холодный рассвет.\nЯ выбираю снова и снова идти —\nНе за медали, не за чей-то дешёвый ответ,\nА чтобы себя в своих собственных глазах найти."}, {"i": "6", "t": "Живи как умеешь", "s": "text", "l": "[Куплет 1]\nЖивёшь удобно. Ты сам не помнишь, где мечта.\nТы ждёшь, что скажет о тебе толпа.\nТы разрешаешь ей менять тебя.\nТы строишь день по их часам.\nТы сам не веришь своим словам.\nТы каждый вечер входишь в сеть.\nТы выставляешь жизнь, которой нет.\nТы видишь в зеркале не себя.\nТы ждёшь, что кто-то решит за тебя,\nПока играешь чужую роль.\n\n[Пре-припев]\nПускай твердят, что ты свернул\nИ что идёшь совсем не так.\nЛишь тот, кто падал, но шагнул вперёд,\nСквозь боль сильнее стал.\n\n[Припев]\nЖиви, как умеешь, не слушай чужих мнений.\nТы не обязан быть удобным для людей.\nПускай они считают все твои падения —\nТы поднимайся и становись ещё сильнее.\nЖиви, как умеешь, без масок и сравнений.\nИ только ты решаешь, кто ты. Наконец, живи.\nНикто не проживёт твою жизнь за тебя.\nЖиви, даже если тебя не поймут.\n\n[Куплет 2]\nЖил — ты верил тем, кто громче кричал.\nТы каждый совет за закон принимал.\nТы выбирал молчание в ответ.\nТы соглашался, хоть думал «нет».\nТы отдавал им лучшие дни.\nТы ждал, что однажды оценят они.\nТы планы свои переносил на потом.\nТы жил по-чужому, забыв о своём.\nТы ждал, что однажды выберут тебя.\nТы понял: пора выбирать себя.\n\n[Бридж]\nПускай ты падал сотни раз.\nПускай не верили в пути.\nЕсть только ты в этот час.\nЖиви, не бойся, иди.\n\n[Припев]\nЖиви, как умеешь. Не слушай чужих мнений.\nТы не обязан быть удобным для людей.\nПускай они считают все твои падения —\nТы поднимайся и становись ещё сильнее.\nЖиви как умеешь, без масок и сравнений.\nИ только ты решаешь, кто ты. Наконец, живи.\nНикто не проживёт твою жизнь.\nЗа тебя живи, даже если тебя не поймут.\nЖиви.\n\n[Аутро]\nТы больше не ждёшь разрешения.\nТы сам принимаешь решение.\nТы больше не просишь, пойми.\nТы просто живёшь не для них.\n\n[Припев]\nЖиви, как умеешь, не слушай чужих мнений.\nТы не обязан быть удобным для людей.\nПускай они считают все твои падения —\nТы поднимайся и становись ещё сильнее.\nКак умеешь, без масок и сравнений.\nИ только ты решаешь, кто ты. Наконец, живи.\nНикто не проживёт твою жизнь за тебя.\nЖиви, даже если тебя не поймут.\nЖиви, живи, как умеешь.\nНе для них. Для себя. Живи."}, {"i": "7", "t": "Когда ты удобен", "s": "text", "l": "[Куплет 1]\nКак много пройдено дорог, сколько стёртых каблуков.\nПочему ты так одинок среди напрасных слов?\nКак ты раздаривал тепло, сколько песен подарил.\nПочему, когда время пришло, ты выбился из сил?\n\n[Припев]\nСколько ни бейся, сколько ни старайся,\nДля всех хорошим никогда не стать.\nКогда ты удобен, тобой восхищаются.\nКогда ты колючий, мешаешь спать.\nМир любит лишь тех, кто не просит ответа.\nКто встроен, как в механизм?\nНо если ты ищешь капельку света,\nГотовься к тому, что потянут вниз.\n\n[Куплет 2]\nКак ты строил эти мосты, сколько правды вложил в дела?\nПочему на краю пустоты твоя совесть ещё была?\nКак ты делил последний хлеб, сколько раз подставлял плечо?\nПочему этот мир слеп, хотя солнце печёт горячо?\n\n[Припев]\nСколько ни бейся, сколько ни старайся,\nДля всех хорошим никогда не стать.\nКогда ты удобен, тобой восхищаются.\nКогда ты колючий, мешаешь спать.\nМир любит лишь тех, кто не просит ответа.\nКто встроен, как в механизм?\nНо если ты ищешь капельку света,\nГотовься к тому, что потянут вниз.\n\n[Бридж]\nКак ветер качает сухую траву.\nПочему тишина звучит как набат?\nСколько ты видел чудес на веку?\nКак дорого стоит твой каждый закат.\nКак ты верил в чужую мечту? Сколько жизней в себе несёшь.\nПочему, выбирая высоту, ты всегда попадаешь в дождь,\nКак всё, что ты сделал, уйдёт в песок? Сколько смысла в твоих шагах?\nПочему этот жизненный срок сгорает в твоих руках?\n\n[Припев]\nСколько ни бейся, сколько ни старайся,\nДля всех хорошим никогда не стать.\nКогда ты удобен, тобой восхищаются.\nКогда ты колючий, мешаешь спать."}, {"i": "8", "t": "О чём мечтаешь ты", "s": "text", "l": "[Куплет 1]\nЧтобы просто дойти до окна,\nУвидеть, как светает,\nЧтобы утром проснуться и знать:\nБоль тебя отпускает.\nЧтобы завтрашний день наступил\nИ принёс то, что ждёшь.\n\nА кто-то бежит по перрону,\nПроклиная свой поезд и дождь.\nОн не видит, как мимо него\nУтекают минуты и дни.\nОн так многим на свете богат,\nТолько сам не заметил любви.\n\n[Припев]\nРасскажи мне, о чём мечтаешь ты,\nЧто скрываешь в глубине души:\nО покое, о доме, о большой любви.\nРасскажи мне, только не молчи.\nРасскажи мне, о чём мечтаешь ты,\nИ я пойму, чем ты жил.\n\n[Куплет 2]\nИногда наши главные мечты —\nЭто то, что кто-то давно обрёл:\nЧтобы кто-то остался с тобой,\nКогда прочие двери закрылись,\nЧтобы имя твоё хоть однажды\nС настоящим теплом произнесли,\nЧтобы дом был не просто стеной,\nА местом, где любят и ждут,\nЧтобы после далёких дорог\nТы всегда возвращался к нему.\n\nА кто-то сидит за столом,\nГде родные собрались кругом,\nНо считает минуты до встречи\nС тем, что сам называет своим домом.\nУ него есть всё то, о чём кто-то\nПросит судьбу по ночам.\nНо порой человек ищет счастье\nТам, где счастье не встретится нам.\n\n[Припев]\nРасскажи мне, о чём мечтаешь ты,\nЧто скрываешь в глубине души.\nО покое, о доме, о большой любви.\nРасскажи мне, только не молчи.\nРасскажи мне, о чём мечтаешь ты,\nИ я пойму, чем ты жил.\n\n[Бридж]\nИногда наши главные мечты —\nЭто то, что кто-то давно обрёл:\nЧтобы просто любить,\nНе прося за любовь ни наград, ни ответа,\nЧтобы вера жила внутри.\nДаже если вокруг мало света,\nЧтобы в старости тихо сказать:\n«Я любил, я мечтал, я успел,\nЧтобы жизнь свою действительно прожить,\nА не просто дойти до предела».\n\nОн однажды получит ответ,\nТолько поздно поймёт его суть.\nМожно долго искать свою жизнь\nИ однажды забыть, где твой путь.\nМечта — это зеркало нашей души.\nТы взгляни в него и не спеши.\nКто мечтает однажды подняться с земли,\nТот, наверное, не раз уже падал вдали.\nЯ, кто крылья имеет, порою забыл,\nКак когда-то о небе ночами просил.\nМы не ценим того, что хранится в руках,\nПока сами не встретим потерю в дверях.\n\n[Припев]\nРасскажи мне, о чём мечтаешь ты,\nЧто скрываешь в глубине души.\nБез наград, без имён, без чужой правоты.\nКто ты есть, когда мир замолчит?\nРасскажи мне, о чём мечтаешь ты.\nЯ пойму, чем ты жил.\nРасскажи."}, {"i": "9", "t": "В чём смысл", "s": "text", "l": "[Куплет 1]\nТы открыл глаза утром. Мир был большой.\nКто-то тёплой ладонью провёл над тобой.\nМать сказала: «Ну, здравствуй».\nИ ты был живой. Целый мир был твоим.\nОн лежал под рукой. Всё казалось так просто.\nИ текли реки.\nТолько ты не думал,\nЧто на корточках ты хотел этот мир поменять на свой лад.\nТолько мир между делом поменял твой взгляд.\n\n[Припев]\nОт рассвета до тьмы между ними лишь ты.\nТы всё бежишь по дороге. Но куда и зачем?\nСкажи, в чём. Пока горит твой огонь,\nСкажи, в чём смысл, в чём.\nМы живём, не спросив ни о чём.\n\n[Куплет 2]\nГоды шли как вагоны.\nПонедельник, среда — ты копил на потом.\nТолько после бед ты глядел на чужие.\nНедоступные сны, а своя внутри песня затихала в тени.\nТы откладывал нежность, не звонил, не спешил,\nА песок сквозь ладони.\nИ миг твой застыл от рассвета до тьмы.\n\n[Припев]\nМежду ними лишь ты.\nТы всё бежишь по дороге. Но куда и зачем?\nСкажи, в чём. Пока горит твой огонь,\nСкажи, в чём смысл, в чём.\nМы живём, не спросив ни о чём.\n\n[Бридж]\nВот и зеркало.\nСидя на увиках, где тот парень и небо,\nКоторое было в мечтах.\nИ теперь он всё понял, поздно.\nНо, увы, смысл был не в монетах,\nВ тех, кто рядом, в тех, кто ждёт.\nОт рассвета до тьмы между ними.\nЖиви, не жди знака на небе.\nПросто вот он твой день. Так живи.\nПока горит твой огонь.\nТак живи, чтоб не жалел ни о чём."}, {"i": "10", "t": "Там где ты", "s": "text", "l": "[Куплет 1]\nТам, где туман обнимает рассвет.\nТам, где у слов больше тяжести нет.\nТам, где в ладонях заснуло тепло,\nВсё, что болело, давно зажило.\nТам, где начало для новой главы,\nТише воды и ниже травы.\n\n[Припев]\nТы, ты, только ты.\nМой рассвет в океане.\nТы, ты, только ты.\nТихий шёпот признаний.\nТы, ты, только ты.\nВсё, в чём я растворяюсь.\nКаждый раз в этот мир\nЛишь с тобой возвращаюсь.\n\n[Куплет 2]\nТам, где над морем парит тишина,\nСлышно, как в сердце поёт глубина.\nТам, где не нужно искать оправданий,\nВне расстояний и вне ожиданий.\nТам, где мы просто стоим у черты,\nВидя, как в мире сбываются сны.\n\n[Припев]\nТы, ты, только ты.\nМой рассвет в океане.\nТы, ты, только ты.\nТихий шёпот признаний.\nТы, ты, только ты.\nВсё, в чём я растворяюсь.\nКаждый раз в этот мир\nЛишь с тобой возвращаюсь.\n\n[Бридж]\nВыше любых облаков и мостов,\nТам, где не хватит и тысячи слов.\nПросто смотреть, как качается свет,\nЗная, что тени отныне здесь нет.\n\n[Припев]\nТы, ты, только ты.\nМой рассвет в океане.\nТы, ты, только ты.\nТихий шёпот признаний.\nТы, ты, только ты.\nВсё, в чём я растворяюсь.\nКаждый раз в этот мир\nЛишь с тобой возвращаюсь.\nТолько ты.\n\n[Аутро]\nAh."}, {"i": "11", "t": "Живи сейчас", "s": "text", "l": "[Припев]\nЖиви сейчас без отлагательств —\nНачни с себя, наполни жизнь.\nНе будь в плену у обстоятельств,\nК себе получше присмотрись.\nОткрой глаза на все проблемы,\nНасколько им с тобою по пути?\nДостигнуть ли, их не решив, цели,\nПо льду сомнений перейти?\nПо льду сомнений перейти?\n\n[Куплет 1]\nПо меркам чьим себя ты меришь,\nГде смысл жизни подсмотрел?\nКак сильно в сказку ни поверишь,\nЧуть что — ты будешь не у дел!\nУверен в том, что ты за всех в ответе,\nНа всё ли хватит тебе сил?\nКто вспомнится при выключенном свете,\nО чём так будешь сожалеть, что позабыл?\n\n[Припев]\nЖиви сейчас без отлагательств —\nНачни с себя, наполни жизнь.\nНе будь в плену у обстоятельств,\nК себе получше присмотрись.\nОткрой глаза на все проблемы,\nНасколько им с тобою по пути?\nДостигнуть ли, их не решив, цели,\nПо льду сомнений перейти?\nПо льду сомнений перейти?\n\n[Бридж]\nЖиви сейчас.\nЖиви сейчас.\n\n[Куплет 2]\nЧего необъяснимо сторонишься,\nЧто вызывает боль и страх?\nОт них в себе не скрыться,\nИ там они мерещатся во всех углах.\nДавно пора во всём признаться,\nЖивёшь ты будто вопреки,\nЧтоб окончательно не разочароваться,\nСебя как есть прими и полюби!\n\n[Аутро]\nЖиви сейчас без отлагательств —\nНачни с себя, наполни жизнь.\nНе будь в плену у обстоятельств,\nК себе получше присмотрись…\nЖиви сейчас…"}, {"i": "12", "t": "Твоё плавание не вечно", "s": "text", "l": "[Куплет 1]\nЖизнь — это судно, что вечно в движении.\nМы выходим из тумана сквозь сомнения,\nНагруженные историями, что хотим оставить на берегу.\nНо море молчит, забирая плату свою.\nМы смотрим вдаль, где мерцают огни,\nВеря, что кто-то запомнит наши следы.\nНо волны стирают всё без следа,\nИ только время рассудит тогда.\n\n[Припев]\nТвоё плавание не вечно.\nПомни об этом всегда.\nМоре забирает время.\nВсё забирает вода.\nБыл ли ты капитаном\nИли плыл по течению вдаль?\nКогда погаснут все маяки,\nЧто ты оставишь после себя?\n\n[Куплет 2]\nГавань манит коротким теплом.\nБудни привязывают душу узлом.\nКажется, будто вся вечность впереди.\nНо жизнь ускользает быстрее реки.\nМы ищем спасение в чужих голосах,\nВ напудренных масках и ярких огнях.\nПьём аромат чужих надежд,\nНе замечая собственных потерь.\n\n[Припев]\nТвоё плавание не вечно.\nПомни об этом всегда.\nМоре забирает время,\nВсё забирает вода.\nА был ли ты капитаном\nИли плыл по течению вдаль?\nКогда погаснут все маяки,\nЧто ты оставишь после себя?\n\n[Куплет 3]\nВ полумраке комнаты, дымом ночным\nМы прячем пустоту за случайным теплом.\nШепчем имена, что забудем к утру,\nОставляя совесть одну на ветру.\nКогда свеча догорит до конца,\nЧто останется, кроме золы и свинца?\nЛишь эхо шагов в тишине\nДа вопросы к самому себе.\nВ барах шумит всё до утра.\nТолпа заглушает голос внутри нас.\nМы ищем любовь, но находим лишь день,\nКоторый исчезает, как дождь в этот день.\nАзарт улетучился, страсть позади.\nДва незнакомца лежат в темноте одни.\nМежду ними неметры моря,\nИ холодная улица ждёт у дверей.\n\n[Припев]\nТвоё плавание не вечно.\nПомни об этом всегда.\nМоре забирает время,\nВсё забирает вода.\nБыл ли ты капитаном\nИли плыл по течению вдаль?\nКогда погаснут все маяки,\nЧто ты оставишь после себя?\n\n[Бридж]\nВ конце пути друзья поднимут тебя,\nИ корабль снова уйдёт в моря.\nВолны качнут его старый борт.\nИ время подведёт итог.\nБыл ли твой свет маяком во тьме\nИли растворился в пустой суете?\nВедь плавание скоро закончится вновь,\nИ останется только память о нём.\n\n[Припев]\nТвоё плавание не вечно.\nПомни об этом всегда.\nМоре забирает время,\nВсё забирает вода.\nБыл ли ты капитаном\nИли плыл по течению вдаль?\nКогда погаснут все маяки,\nЧто ты оставишь после себя?\n\n[Аутро]\nAh."}, {"i": "13", "t": "Меня не сломать", "s": "text", "l": "[Куплет 1]\nА вам меня не сломать.\nХоть сука кровью умойтесь,\nЯ буду дальше шагать,\nТак что давайте, успокойтесь.\nЯ в эти ямы падала\nЛицом в бетон и книги,\nНо вы меня не прятали —\nЯ просто вышла из интриги.\n\n[Припев]\nМеня не сломать,\nХоть по кускам, по жилкам режьте (эй).\nЯ буду стоять,\nДаже когда горит всё в печке.\nИ не мойте мои кости,\nИ не плетите свои книги.\nМеня не сломать —\nЯ выше ваших интриг.\n\n[Куплет 2]\nВы шепчетесь по подъездам,\nЯ слышу каждую букву.\nНо мне смешны ваши тезисы —\nЯ жизнь сдаю не на скупку.\nЯ с каждой трещиной крепче,\nВы с каждым слухом мельче.\nЯ вырастаю из пепла,\nА вам всё кажется легче.\n\n[Припев]\nМеня не сломать,\nХоть по кускам, по жилкам режьте (да).\nЯ буду стоять,\nДаже когда горит всё в печке.\nИ не мойте мои кости,\nИ не плетите свои книги.\nМеня не сломать —\nЯ выше ваших интриг.\n\n[Бридж]\nЯ на себе таскала\nВаши прогнозы, ярлыки.\nНо если сердце закаляло —\nЗначит, мне с вами не по пути.\n\n[Припев]\nМеня не сломать,\nХоть по кускам, по жилкам режьте (меня).\nЯ буду стоять,\nДаже когда горит всё в печке.\nИ не мойте мои кости,\nИ не плетите свои книги.\nМеня не сломать —\nЯ выше ваших интриг (выше, выше)."}, {"i": "14", "t": "Не спеши осуждать", "s": "text"}, {"i": "15", "t": "Нас учат потери", "s": "text"}, {"i": "16", "t": "Не вам жить мою жизнь", "s": "text", "l": "[Куплет 1]\nЯ пою и молюсь, я кричу и боюсь\nНеуслышанным остаться тобой.\nЯ прошу: дай мне слёз, чтобы выплакать мог\nТо, что в сердце моём наболело.\nПрикоснись и вдохни тёплых рук своих жизнь\nВ бездыханное тело души.\nИ она запоёт о любви…\n\n[Куплет 2]\nНа сцене я жизнью живу настоящей,\nМне светит в лицо оживляющий луч,\nА там, за кулисами, маленький ящик,\nВ который меня запирают на ключ.\nПо ниточке, по ниточке ходить я не желаю.\nОтныне я, отныне я, отныне я живая.\nПо ниточке…\n\n[Куплет 3]\nДумай почаще своей головой,\nБольше не знаю секретов.\nЗнай, что придёт этот час роковой,\nЧтобы дать море ответов.\nТы меня всё равно не поймёшь,\nЧто ты знаешь о жизни моей?\nКаждый день для себя ты живёшь\nУже триста семнадцатый день.\nНо не жить…"}, {"i": "17", "t": "Я сам себе судья", "s": "text", "l": "[Куплет 1]\nЯ набрал дистанцию, я выключил звук.\nМне не нужен повод, я не жду чужих рук.\nСам себе опора, сам себе верный друг.\nЯ строю этот мир, пока другие просто ждут.\nВспышки городов, в навигаторе — мечта.\nМой личный горизонт, моя высота.\nНе ищи меня в толпе, я на своей волне.\nВсё, что мне так нужно, всегда во мне.\nЛечу на восток, где рождается свет.\nВ кармане билет на вопрос-ответ.\nТокио, Киото — неоновый блик.\nЯ ловлю этот драйв, я ловлю этот миг.\nЗабудь про советы, пустой разговор.\nЯ сам себе судья и сам себе прокурор.\nПока не спорят, кто круче в сети,\nЯ уже проложил сто путей впереди.\nМоё время — валюта, мой почерк — огонь.\nУдача сама ложится в ладонь.\nМеня зовут гулять. Кто-то зовёт в игру,\nКто-то хочет знать, как я так круто живу.\nНо я выберу тишину, я выберу свой темп.\nВ этой истории нет лишних эмблем.\nЯ и сам отлично справляюсь, поверь.\nДля новых побед открыта каждая дверь.\n\n[Припев]\nЯ набрал дистанцию, я выключил звук.\nМне не нужен повод, я не жду чужих рук.\nСам себе опора, сам себе верный друг.\nЯ строю этот мир, пока другие просто ждут.\nВспышки городов, в навигаторе — мечта,\nМой личный горизонт, моя высота.\nНе ищи меня в толпе, я на своей волне.\nВсё, что мне так нужно, всегда во мне."}, {"i": "18", "t": "Тень ушедших", "s": "text"}, {"i": "19", "t": "Вне зоны доступа", "s": "text"}, {"i": "20", "t": "Не теряй шанс", "s": "text"}, {"i": "21", "t": "Действуй сейчас", "s": "text"}, {"i": "22", "t": "Просто люби", "s": "text"}, {"i": "23", "t": "Код перемен", "s": "text"}, {"i": "24", "t": "Компас на Дом", "s": "text"}, {"i": "25", "t": "Ангел без крыльев", "s": "text", "l": "[Куплет 1]\nЗдесь небо пахнет горечью, а земля — свинцом.\nЯ прижался к бетону разбитым лицом.\nВокруг тишина, что страшнее любого крика.\nИ вечность застыла в одном коротком миге.\nЯ звал на помощь. Голос просто пропал.\nЯ в этой секунде надежду потерял.\nНо чьи-то руки — на тебе камуфляж и шипы,\nНо ты превращаешь в надежду эту страшную быль.\nШепчешь: дыши.\nЯ снова пробую жить, связывая заново разорванную нить.\n\n[Припев]\nЯ не видел крыльев, но ты меня спасала.\nИз самого дна за руку выводила к свету.\nТы молитвой тихой над пропастью стояла\nИ на мои вопросы давала мне ответы.\nЕсли я упаду, ты поймай меня снова\nМежду болью и небом.\nКто-то держит меня.\n\n[Куплет 2]\nУ Бога много дел там, за облаками,\nНо здесь, на земле, он действует твоими руками.\nТвои глаза устали, в них застыла печаль.\nТы смотришь сквозь меня в бесконечную даль.\nВокруг скрипит металл, и рвётся горизонт.\nНо для тебя неважен калибр или фронт.\nТы просто ангел без крыльев, без нимба над головой.\nТы споришь со смертью, чтобы я вернулся домой.\nЯ не помню лица, только холод твоих пальцев.\nМы в этой жизни всего лишь китальцы.\nНо пока ты рядом, смерть берёт выходной.\nМой земной хранитель, закрывший меня собой.\nЕсли завтра рассвет, значит, ты была рядом.\nУкрывала от стали своим пристальным взглядом.\nЯ не знаю, как звать тебя, и не знаю молитв,\nНо ты единственный победитель в этой битве.\n\n[Припев]\nЯ не видел крыльев, но ты меня спасала.\nИз самого дна за руку выводила к свету.\nТы молитвой тихой над пропастью стояла\nИ на мои вопросы давала мне ответы.\nЕсли я упаду, ты поймай меня снова\nМежду болью и небом.\nКто-то держит меня между болью и небом.\nКто-то держит меня.\nЕсли завтра свет, значит, ты была рядом."}, {"i": "26", "t": "Всё начинается с тебя", "s": "text", "l": "[Куплет 1]\nПросыпаемся, опять не так.\nМы молчим, ждём тепла, ждём звонка,\nНо опять тишина.\nМы обижены на весь мир.\nНо этот мир — это мы.\nМы злимся на людей, но люди — это мы.\nМы сами строим лабиринты, а потом ищем выход.\nМы ждём любви, но снова молчим.\nМы получаем ровно то, что отдаём.\n\n[Припев]\nМы сами строим мир, в котором мы живём.\nВсё, что за дверью — это наше отражение.\nКаждое слово и каждое движение.\nМы сами — та причина, мы сами — тот итог.\nМир просто возвращает, что ты вложил в него.\nМы — это наш мир от начала до конца.\nВсё начинается с тебя.\n\n[Куплет 2]\nМы хотим, чтобы нас больше понимали,\nНо сами слышать мы устали.\nПросим больше, чем давали,\nТеряя жизненный запал.\nМы ждём свет, когда внутри темно.\nПрячем боль, закрываясь далеко.\nМы снова смотрим на этот мир с обидой,\nНе замечая собственных следов.\nМы получаем ровно то, что отдаём.\n\n[Припев]\nМы сами строим мир, в котором мы живём.\nВсё, что за дверью — это наше отражение.\nКаждое слово и каждое движение.\nМы сами — та причина, мы сами — тот итог.\nМир просто возвращает всё, что ты в него вложил.\nМы — это наш мир от начала до конца.\nВсё начинается с тебя.\n\n[Бридж]\nПопробуй дать тепло, когда его ждут.\nСказать «прости», когда внутри война,\nИ ты увидишь: мир меняется.\nКогда меняешься ты сам.\nМы получаем ровно то, что отдаём.\nМы сами строим мир, в котором мы живём."}, {"i": "27", "t": "Оставайся молодым", "s": "text", "l": "[Куплет 1]\nДа хранит тебя свет и ведёт сквозь года.\nПусть сбываются тихо мечты иногда.\nСтань огнём для других в этой длинной ночи.\nИ добро пусть вернётся к тебе, как лучи.\nПрокладывай путь далёким огнём.\nШаг за шагом сквозь штормы и дым.\nПусть в душе не погаснет твой внутренний свет,\nИ душа остаётся моложе лет.\n\n[Припев]\nОставайся молодым — светлым, чистым, живым,\nВне времени, вне границ.\nОставайся молодым, оставайся молодым,\nСветлым, чистым, живым.\nВне времени, вне границ.\nОставайся молодым.\n\n[Куплет 2]\nСохрани в себе правду и чистую суть.\nНе давай пустоте в своё сердце шагнуть.\nРазличай среди теней настоящий свет.\nИ в простых мелочах находи ответ.\nБудь сильным, когда поднимается шторм,\nИ не гнись под давлением чуждых форм.\nПусть твой дух, словно ветер, летит над землёй\nИ останется навсегда молодой.\n\n[Припев]\nОставайся молодым — светлым, чистым, живым,\nВне времени, вне границ.\nОставайся молодым, оставайся молодым,\nСветлым, чистым, живым.\nВне времени, вне границ.\nОставайся молодым.\n\n[Бридж]\nПусть работа и путь наполняют твой день.\nИ не будет в душе ни усталости, ни теней.\nОпирайся на себя в переменах судьбы,\nКогда ветер несёт новые сны и мечты.\nПусть звучит в твоём сердце живая весна,\nНе смолкая ни днём, ни во власти сна.\nСквозь года пронеси этот свет, сквозь века.\nПусть душа остаётся легка.\n\n[Припев]\nОставайся молодым — светлым, чистым, живым,\nВне времени, вне границ.\nОставайся молодым, оставайся молодым,\nСветлым, чистым, живым.\nВне времени, вне границ.\nОставайся молодым."}, {"i": "28", "t": "Разгадка в небесах", "s": "text"}, {"i": "29", "t": "Время как вода", "s": "text", "l": "[Куплет 1]\nЯ всё спешил. Я гнался за мечтой.\nКазалось, впереди ещё так много.\nМенял закаты на ночной покой.\nДумал, время — не бездонная дорога.\nНо вдруг поймал себя на тишине.\nНазад не перемотать ни дня, ни часа.\nМы всё бежим, не замечая свет,\nНе слыша, как уходит лето.\nА время — самый честный наш ответ.\nЕго нельзя поставить на паузу где-то.\n\n[Припев]\nА время капает, как талая вода.\nСквозь пальцы назад, не возвращаясь,\nНе оставляйте на потом и навсегда.\nТо, что сегодня в сердце оказалось:\nОбнять детей, родителям набрать,\nПростить врага и просто выпить чаю.\nУчись секунды не терять,\nВедь время в жизни не прощает.\n\n[Куплет 2]\nМы всё доказываем, кто сильнее.\nСгораем в гонке без финала.\nА счастье в простых вещах и в тех людей,\nКоторых рядом было мало.\nИ правда прячется в тишине.\nСердце говорит без страха,\nА время капает, как талая вода.\nСквозь пальцы назад, не возвращаясь,\nНе оставляйте на потом и навсегда.\n\n[Припев]\nТо, что сегодня в сердце оказалось:\nОбнять детей, родителям набрать,\nПростить врага и просто выпить чаю.\nУчись секунды не терять,\nВедь время в жизни не прощает.\n\n[Аутро]\nСлышишь пульс? Каждый вдох — как новый старт.\nНе прожигай этот миг, он уже никогда не повторится.\nВремя капает, как талая вода.\nУчись секунды не терять,\nВедь время в жизни не прощает."}, {"i": "30", "t": "Не играй в любовь", "s": "text", "l": "[Куплет 1]\nУтро за окном, в зеркале — чужой.\nТы опять играл и доволен сам собой,\nРаздавал слова, обещал весь мир.\nСегодня любовь — это просто тир.\nТы менял сердца как в автобензин\nИ всегда считал, что ты господин.\nНо в жизни есть свой крутой расклад.\nКто в любовь играл, не придёт назад.\n\n[Припев]\nНе играй в любовь — жизнь проиграешь.\nЭту ставку ты не перебьёшь.\nСам себя во лжи ты потеряешь,\nА потом назад не повернёшь.\nНе играй в любовь.\nЭто не игрушка.\nЖизнь потом ударит точно в цель.\nИ пустая ждёт тебя подушка,\nИ в душе холодная метель.\n\n[Куплет 2]\nВперёд не считали,\nНо на каждый фальш выписан билет.\nОглянёшься — вдруг рядом никого.\nТолько тень твоя, больше ничего.\nБлеск чужих огней, холод ихних глаз.\nТы любовь предал уже сотни раз.\nНо пришёл финал. За столом — пустота.\nСвою жизнь ты теперь глядишь с моста.\n\n[Припев]\nНе играй в любовь — жизнь проиграешь.\nЭту ставку ты не перебьёшь.\nСам себя во лжи ты потеряешь,\nА потом назад не повернёшь.\nНе играй в любовь.\nЭто не игрушка.\nЖизнь потом ударит точно в цель.\nИ пустая ждёт тебя подушка.\nИ в душе холодная метель.\n\n[Бридж]\nА счастье — карта, его не сопрёшь.\nЗа деньги и хитрость его не возьмёшь.\nПоймёшь это поздно,\nКогда за спиной\nОстанется пепел и берег чужой.\nБерег чужой.\n\n[Припев]\nНе играй в любовь — жизнь проиграешь.\nЭту ставку ты не перебьёшь.\nСам себя во лжи ты потеряешь.\nА потом назад не повернёшь.\nНе играй в любовь.\nЭто не игрушка.\nЖизнь потом ударит точно в цель.\nИ пустая ждёт тебя подушка.\nИ в душе холодная метель.\nЖизнь проиграет.\nНе играй в любовь."}, {"i": "31", "t": "Когда погаснут огни", "s": "text"}, {"i": "32", "t": "Смысл жизни прост", "s": "text"}, {"i": "33", "t": "Пленники прошлого", "s": "text"}, {"i": "34", "t": "Гордость нас убивает", "s": "text"}, {"i": "35", "t": "Одиночество среди людей", "s": "text"}, {"i": "36", "t": "Вера остаётся", "s": "text", "l": "[Куплет 1]\nЧертежи разбиты пылью.\nТо, что строили годы, стало просто былью.\nТишина оглушает, осыпаются стены.\nИ привычное завтра вышло прочь из системы.\nМы искали опору в вещах, именах,\nВ камне, цифрах, табличках и громких словах.\nИ когда на ладонях лишь горсть черепков,\nМы пугаемся вдруг своих слабых шагов.\nНо в эпицентре шторма, где гаснут огни,\nЕсть нечто сильнее и выше, чем дни.\nКогда рушится форма, рождается суть.\nИ только открытым сердцам виден путь.\n\n[Припев]\nКогда всё рушится, вера остаётся\nДиким светом со дна бездонного колодца.\nНе догма, не крик, не чужое слово.\nЭто корень, на котором всё вырастет снова.\nПусть кружится мир, ты стоишь на камне.\nВера — не храм, это свет внутри спальни.\nЕй не страшны руины и пепел седой.\nПод тяжестью потерь она гребнет собой.\n\n[Куплет 2]\nМы боялись остаться ни с чем в пустоте,\nЗабывая: все звёзды видны в темноте.\nВ той ночи, где богатства земные огни,\nПроявляются смыслы и наши пути.\nВсё, что можно отнять, нам не принадлежит.\nУ иллюзий одна лишь привычка — прожить.\nНо того, что внутри, не сломает беда.\nВера живая, как сквозь камни вода.\nНе спрашивай «за что», спроси лишь «зачем».\nРазруха не точка, а рост перемен.\nКогда вдребезги падает старый доспех,\nТы чувствуешь жизнь без границ и помех.\n\n[Припев]\nКогда всё рушится, вера остаётся\nДиким цветом со дна бездонного колодца.\nДа не догма, не крик, не чужое слово.\nЭто корень, на котором всё вырастет снова.\nПусть кружится мир, ты стоишь на камне.\nВера — не храм, это свет внутри спальни.\nЕй не страшны руины и пепел седой.\nПод тяжестью потерь она гребнет собой.\n\n[Аутро]\nИ когда осядет пыль, взойдёт рассвет,\nТы увидишь: зданий нет, а внутри тебя свет.\nПросто верь, даже в пепле\nЖивёт цветок."}, {"i": "37", "t": "Суть проста", "s": "text"}, {"i": "38", "t": "Страх не слабость", "s": "text"}, {"i": "39", "t": "Остаться человеком", "s": "text", "l": "[Куплет 1]\nВ метро сегодня снова не протолкнуться.\nТысячи лиц, и у каждого свой маршрут.\nМы учимся мимо друг друга проснуться,\nБоясь прикоснуться — вдруг нас прочтут.\nВ карманах сияют холодные экраны.\nТам счастье в витринах, успех на прокат.\nЧем больше друзей, тем глубже раны.\nИ фраза «нормально» — как заученный факт.\n\n[Припев]\nЭто странный плен —\nОдиночество среди людей.\nВ океане глаз мы теряем своих друзей.\nГромкий смех вокруг, а внутри тишина и лёд.\nТы стоишь в толпе, но никто не зовёт.\nОдиночество в самом центре большой мечты,\nГде стираются смыслы, сжигаются мосты.\nОдиночество, но оно — не ты.\n\n[Куплет 2]\nВ мире масок привычка скрывать,\nКак страшно порой просто жить и дышать.\nМы строим из слов непреступные стены,\nНо жажда тепла подскажет, как верно.\n\n[Припев]\nЭто странный плен —\nОдиночество среди людей.\nВ океане глаз мы теряем своих друзей.\nГромкий смех вокруг, а внутри тишина и лёд.\nТы стоишь в толпе, но никто не зовёт.\nОдиночество в самом центре большой мечты,\nГде стираются смыслы и сжигаются мосты.\n\n[Бридж]\nМы боимся быть слабыми, быть живыми.\nПрячем сердце за ролями и именами.\nЗакрываемся в броню, выходя на бой.\nНо выход не там, где нет нас и покой.\nОн там, где не нужно казаться сильней.\nПросто выдохни.\nТы рядом.\nТы есть.\n\n[Аутро]\nЭто странный плен —\nОдиночество среди людей.\nНо даже в холодной толпе ты можешь быть теплей.\nЕсли холод внутри — не молчи, не беги,\nПросто руку протяни.\nТы не один.\nДаже если вокруг миллионы холодных лиц.\nОдиночество не навсегда внутри.\n\n[Куплет 3]\nРассвет, как стекло. Всё понятно давно.\nЗакрыть своё сердце на ключ — это не мой закон.\nЯ могу стать камнем или стать ветром.\nЯ — своя собственная правда.\nЯ лечу к свету.\nГолос внутри меня жив.\nДыши, будь здесь, в ритме своей жизни.\n\n[Припев]\nОставаться человеком, когда мир давит на грудь.\nОставаться человеком и не свернуть с пути\nСквозь боль и ложь.\nКаждый вдох держит меня, тянет к свету.\nЯ свой собственный бог.\nОставаться человеком.\nОставаться человеком.\n\n[Куплет 4]\nХолод во взглядах, будто мир против нас.\nОни говорят: «Не верь, гасит каждый шанс».\nНо я видел свет там, где нет уже веры.\nСлово — как укрытие, моё перерождение.\nГолос внутри меня жив.\nДыши здесь, в ритме своей жизни.\n\n[Припев]\nОставаться человеком,\nКогда мир давит на грудь.\nОставаться человеком,\nНе свернуть сквозь боль и ложь.\nКаждый вдох держит меня,\nТянет к свету.\nЯ свой собственный бог.\nПусть струны рвутся,\nЯ беру жизнь до края.\nМой дух не сломить, я остаюсь.\nЯ знаю: просто быть собой —\nПросто оставаться человеком.\nСложнее, чем выжить.\nОстаться собой."}, {"i": "40", "t": "Ты одна дала", "s": "text"}, {"i": "41", "t": "Ты Главный игрок", "s": "text"}, {"i": "42", "t": "Жизнь не прощает", "s": "text"}, {"i": "43", "t": "Неудача — не конец", "s": "text", "l": "[Куплет 1]\nВ жизни курорт набьёт, не жалея сил.\nКаждый из нас хоть раз судьбы пощады просил.\nМы мерим успех по чужим счетам,\nЗабыв, что победа даётся в тяжёлых боях,\nКогда под ногами земля ушла в обрыв\nИ кажется: всё это финиш и нервный срыв.\nПрисядь на скамью, посмотри на свои ладони.\nВ них сила осталась, а время оно не догонит.\n\n[Припев]\nНеудача — не яма.\nЭто просто затишье перед решающим шагом.\nНеудача — не финиш, а просто крутой поворот.\nЭто плата за мудрость, что в тебе живёт.\nЕсли падал ты в грязь — значит, выше сумеешь взлететь.\nКаждый шрам на душе — это путь большой мечте.\nЭто факел, что светит в густой темноте.\nНе кляни свои беды.\nВ них скрыт твой грядущий успех.\n\n[Куплет 2]\nТот, кто не падал, не знает, как твёрдо стоять.\nЛёгкие лавры — не повод судьбу прославлять.\nНастоящий триумф пахнет кровью и солью дорог.\nОн приходит к тому, кто осилить падение смог.\n\n[Припев]\nНеудача — не финиш, а просто крутой поворот.\nЭто плата за мудрость, что в тебе живёт.\nЕсли падал ты в грязь — значит, выше сумеешь взлететь.\nКаждый шрам на душе — это путь большой мечте.\nЭто факел, что светит в густой темноте.\nНе кляни свои беды.\nВ них скрыт твой грядущий успех.\n\n[Бридж]\nСлышишь, тишина?\nВ ней рождается новый рассвет.\nТам, где был тупик,\nТеперь виден твой собственный след.\nИди вперёд,\nА неудача — это просто начало большой победы.\n\n[Припев]\nНеудача — не финиш, а просто крутой поворот.\nЭто плата за мудрость, что в тебе живёт.\nЕсли падал ты в грязь — значит, выше сумеешь взлететь.\nКаждый шрам на душе — это путь большой мечте."}, {"i": "44", "t": "Время покажет", "s": "text", "l": "[Куплет 1]\nЯ душу открывал, как двери в старый дом.\nЗвал кого-то погреться, угощал вином.\nЯ думал: если честен ты — честны с тобой.\nИ в бой за другого шёл, как за себя горой.\nНо искренность нынче — валюта не в цене.\nОдни грели руки на моём огне,\nДругие кивали, пряча хитрый взгляд,\nГотовили в спину свой дешёвый яд.\n\n[Припев]\nВремя — лучший доктор и судья.\nОно покажет, кто есть кто и кто есть я.\nСрывает ветер маски с лиц, как жухлую листву.\nКто был с тобой во сне, а кто — наяву?\nНе торопись судить.\nПускай пройдут года,\nВода уйдёт и обнажит дно пруда.\nИ ты увидишь: кто хранил, а кто играл,\nКто руку жал, а кто её ломал.\n\n[Куплет 2]\nОни считали: доброта — слабый знак,\nЧто если ты прощаешь, значит, ты простак.\nКрутили схемы, плели липкую вранья нить,\nПытались душу мне на мелочь разменять.\nЯ карты клал на стол, рубашкой вниз, открыто,\nА их колода была краплёная, бита.\nЯ проиграл. Казалось, всё, что мог, отдал,\nНо я остался собой, а им ещё бежать.\n\n[Припев]\nА время — лучший доктор и судья.\nОно покажет, кто есть кто и кто есть я.\nСрывает ветер маски с лиц, как жухлую листву.\nКто был с тобой во сне, а кто — наяву?\nНе торопись судить.\nПускай пройдут года,\nВода уйдёт и обнажится дно пруда.\nИ ты увидишь: кто хранил, а кто играл.\nКто руку жал, а кто её ломал?\n\n[Бридж]\nСпасибо тем, кто предал.\nВы дали мне урок:\nНе пускать чужих людей на свой порог.\nНе жаль потраченных монет, не жаль тепла,\nЖаль только веру, что дотла сгорела.\nНо лучше горькая правда, чем сладкий яд.\nЯ выжил, я стою, я не смотрю назад.\n\n[Припев]\nДа, время — честный мастер и судья,\nВсё расставит по местам.\nИ ты увидишь: срывает ветер маски с лиц,\nКак жухлую листву,\nОставив рядом тех, кто по родству —\nНе по крови, а по духу и душе,\nС кем рай в шалаше.\nИ на меже\nВремя открыло карты.\nКончилась игра фальшивым.\nДо свидания.\nА своим — добро.\nСвоим добром настоящим.\n\n[Аутро]\nКто не играл, тот поймёт."}, {"i": "45", "t": "Тишина спасает", "s": "text", "l": "[Куплет 1]\nМы точим фразы, как ножи в пылу обид.\nСтреляем в тех, кто без брони пред нами спит.\nНам кажется: кто громче, тот и прав сейчас.\nНо гнев — плохой советчик в этот час.\nЯ видел, как ломали судьбы об слова,\nКак от одной искры сгорала вся трава.\nКогда внутри кипит и рвётся зверь наружу,\nОстановись, не выпускай его на стужу.\n\n[Припев]\nИногда тишина спасает,\nКогда крик разрывает швы.\nОна лучше всех понимает,\nЧто мы оба пока живы.\nНе сожжённый мост, незакрытая дверь.\nШаг назад от края. Ты мне поверь,\nТам, где слово убило б любовь навсегда,\nИногда спасает одна тишина.\n\n[Куплет 2]\nЛегко ударить словом, словно с плеча,\nИ превратить родного в палача.\nНо сила не в том, чтоб перекричать гром,\nА в том, чтобы бурю не пустить в свой дом.\nВдохни, считай до десяти, смотри в глаза.\nПока не сказано — есть путь назад.\nСлова — вода. Их не собрать в ладонь опять.\nМужчине важно уметь промолчать.\n\n[Припев]\nИногда тишина спасает,\nКогда крик разрывает швы.\nОна лучше всех понимает,\nЧто мы оба пока живы.\nНе сожжённый мост, незакрытая дверь.\nШаг назад от края. Ты мне поверь,\nТам, где слово убило в любовь навсегда,\nИногда спасает одна тишина.\n\n[Бридж]\nПослушай, в этой паузе — вся истина.\nТам нет гордыни, нет страха,\nТолько стук сердца твоего и её.\nЕсли ты промолчишь сейчас,\nТы победишь не её,\nТы победишь войну.\n\n[Аутро]\nИногда тишина спасает,\nКогда мир разлетается в пыль.\nОна раны собою укрывает,\nПревращая сказку в быль.\nНе сожжённый мост, незакрытая дверь.\nЭто шанс всё исправить. Ты мне поверь,\nТам, где слово убило нас навсегда,\nНас спасла сегодня одна тишина.\nПросто помолчи.\nПобудь рядом.\nТишина.\nОна громче слов."}, {"i": "46", "t": "Бой с собой", "s": "text", "l": "[Куплет 1]\nСамый трудный бой в тишине ночей,\nКогда кроме твоей нет других теней.\nТы стоишь на краю своих же мыслей.\nМир внутри разбитого сердца,\nБудто горсть осколков, брызги.\nСамый трудный в жизни бой — это бой с самим собой,\nКогда сердце рвёт на части,\nКогда путь теряешь свой, но поднимешься вновь.\nСтой! И не играй чужую роль.\nНе играй чужую роль.\nОглянись, приди в себя, верни покой,\nА иначе будешь бит судьбой.\n\n[Куплет 2]\nВ зеркальном взгляде, как у чужака,\nКаждая твоя ошибка будто глубокая река.\nНо ты идёшь, несмотря на глубину и боль.\nВедь в твоей жизни этот бой — твоя главная роль.\nТы падаешь, ты встаёшь.\nТебя твоя вера к цели ведёт.\nСквозь шрамы в душе и даже по картам запутанных дорог.\nКаждый шаг — это твой урок.\n\n[Припев]\nСамый трудный в жизни бой — это бой с самим собой.\nКогда сердце рвёт на части,\nКогда путь теряешь свой, но поднимешься вновь.\nСтой! И не играй чужую роль.\nОглянись, приди в себя, верни покой,\nА иначе будешь бит судьбой.\nСудьбой."}, {"i": "47", "t": "Сердце в Огне", "s": "text"}, {"i": "48", "t": "Дорога мой Учитель", "s": "text"}, {"i": "49", "t": "Не Угасай", "s": "text", "l": "[Куплет 1]\nСтены города сжимают грудь,\nМерцают тысячи окон.\nНо тишина внутри, как старый\nЗаброшенный колокол.\nИногда забываю, кто куда\nПлывут эти холодные дни.\nСвет во мне не угасай.\nЧерез темноту меня неси.\nСквозь асфальт, сквозь чужие миры,\nТам, где свободны мои пути,\nСвет во мне не угасай.\n\n[Куплет 2]\nЯ смотрю, как гаснет день,\nКак прячутся в тени люди.\nБоль — она просто мой старый сейф,\nБудто знает все мои коды.\nНо есть огонь — маленький, тихий,\nКоторый не сможет потушить ветер.\nСвет во мне не угасает,\nЧерез темноту меня неси.\nСквозь асфальт, сквозь чужие миры,\nТам, где свободны мои пути,\nСвет во мне не угасай.\n\n[Бридж]\nГде тот мост, чтобы перейти реку?\nГде тот код, чтобы снять одиночество?\nКаждый шаг — это вера.\nКаждый вдох — это надежда.\nСвет во мне не угасай.\nЧерез темноту меня неси.\nСквозь асфальт, сквозь чужие миры.\nТам, где свободны мои пути,\nСвет во мне не угасает.\n\n[Аутро]\nНе угасай.\nНе угасай."}, {"i": "50", "t": "Люди в Масках", "s": "text", "l": "[Куплет 1]\nМы часто верим лицу, но лица — это тень.\nЗа ними мир искусственный, пустые пророчества,\nВсё просто: маски гладки, не видят боли настоящей,\nИ тот, кто улыбается, порой за это платит счастьем.\nИ мы идём по улицам, где правду продают за монеты,\nГде честность называют слабостью,\nА хитрость — новой этикой.\n\n[Припев]\nЛюди в масках, но маски не горят.\nИскру не схватят, правду не хотят.\nМир отражений, где сердце на откат,\nНо сильный тот, кто остаётся без маскарада.\nЛюди в масках.\nИ каждый стал актёр,\nНо как бы ни скрывали — выдаёт их взор.\nЖизнь не про роли, а про внутренний оплот.\nКто держит честность, тот сильнее всяких гор.\n\n[Куплет 2]\nМы часто держим правду, как камень за пазухой, тяжёлый.\nБоимся открываться. Будто честь — ты как лёд.\nНо время бьёт по тем, кто строил стены из обмана.\nИ маска как стекло всегда трескается, будто рана.\nЯ понял мудрость в тишине, а не в словах блестящих.\nИ доброта — не слабость, а выбор сильных, не кричащих.\n\n[Припев]\nЛюди в масках, но маски не горят.\nИх не спасёт игра и лес наград.\nЖизнь смотрит в сердце, а не в маскарад.\nИ каждый видит то, что внутри хранят.\nЛюди в масках, но я иду без них.\nИ если честным быть — это не каждому по силам.\nНо я останусь тем, кто живёт открыто и красиво."}, {"i": "51", "t": "Мои правила", "s": "text", "l": "[Куплет 1]\nУтром солнце встаёт над крышами.\nЯ иду своей верной дорогой.\nГолоса за спиной еле слышны.\nМне не нужно подсказок и многого.\nКаждый метр дороги измеренной.\nКаждый шаг — это личный выбор.\nЯ остался сегодня самим собой.\nИз ловушек и формул выбыл.\n\n[Припев]\nМоя жизнь — это мои правила,\nМой путь, моя судьба и карта.\nМоя жизнь карты на столе расставила,\nНо я сам выбираю день старта.\nДень старта.\nНикто здесь за меня не решит,\nКак жить, улыбаться и верить.\nМой мир только мне принадлежит,\nИ я открываю эти двери.\nЭти двери.\n\n[Куплет 2]\nБывали ветры, грозы и потери,\nНо слёз моих никто здесь не найдёт.\nКто предал раз, тому уже не верю,\nА кто любил, тот до конца поймёт.\nНе шёл на поводу шумной стаи.\nЧужого мнения я в жизни не просил.\nВсе те, кто правил мне свои листали,\nДавно уже остались позади.\n\n[Припев]\nМоя жизнь — это мои правила,\nМой путь, моя судьба и карта.\nЖизнь карты на столе расставила,\nНо я сам выбираю день старта.\nДень старта.\nНикто здесь за меня не решит,\nКак жить, улыбаться и верить.\nМой мир только мне принадлежит.\nИ я открываю эти двери.\nЭти двери.\nМоя жизнь — мои правила.\nМои правила — только мой путь."}, {"i": "52", "t": "Я могу всё", "s": "text", "l": "[Куплет 1]\nСтрелки на часах крутят свой маршрут.\nНоги ломались, многие ещё побегут.\nТолько я спокоен, за спиной года.\nЕсли я задумал — значит будет да.\nВидел я дороги, видел темноту,\nНо свою со старта выбрал высоту.\nЖизнь меня учила бить всегда в упор.\nКаждый мой поступок — честный разговор.\n\n[Припев]\nЯ могу всё, если надо, пройду сквозь огонь.\nВ кулаке зажата крепко моя ладонь.\nЯ могу всё от земли до небесных высот.\nКто со мною рядом, тот меня поймёт.\nЯ могу всё.\nНе пугают крутые мосты.\nВыше суеты до своей мечты.\n\n[Куплет 2]\nЖизнь — это не сказка, это жёсткий трек.\nСам решаю жизни, кто ты, человек.\nСлушал слишком много пустой болтовни,\nНо горели ярче в темноте огни.\nПоднимался снизу, ушёл через туман.\nЗнаю, где тут правда, знаю, где обман.\nСлово держу крепко, как стальной клинок.\nКаждый новый финиш — это мой исток.\n\n[Припев]\nЯ могу всё, если надо, пройду сквозь огонь.\nВ кулаке зажата крепко моя ладонь.\nЯ могу всё от земли до небесных высот.\nКто со мною рядом, тот меня поймёт.\nЯ могу всё.\nМеня пугают крутые мосты,\nВыше суеты до своей мечты.\n\n[Бридж]\nВремя крутит диски, плавит города.\nНо моя порода — кремень, не руда.\nПадали билеты, путались узлы.\nТолько для слабаков в эти дни злые.\nЯ ломаю стены, если нет дверей.\nС каждым новым штормом становлюсь мудрей.\nКуплен этот статус потом и замком.\nЯ иду по жизни дерзким вожаком.\n\n[Припев]\nЯ могу всё, если надо. Пройду сквозь огонь.\nВ кулаке зажата крепко моя ладонь.\nЯ могу всё от земли до небесных высот.\nКто со мною рядом, тот меня поймёт.\nЯ могу всё.\nНе пугают крутые мосты,\nВыше суеты до своей мечты.\nДа, именно так. Своими руками до конца я могу всё.\nИ точка."}, {"i": "53", "t": "Ты только моя", "s": "text", "l": "[Куплет 1]\nУтренний луч заглянул в наше окно.\nМир вокруг нас засиял, как в кино.\nЯ созерцаю твой тихий нежный сон.\nВ чистую радость я навек влюблён.\nКаждый твой вдох — это музыка дня.\nСамая лучшая жизнь у меня.\n\n[Припев]\nТы только моя, мой безоблачный свет.\nВ целой вселенной тебя краше нет.\nСловно весна посреди зимних дней.\nС каждой минутой люблю всё сильнее.\nТы мой покой, мой причал, моя высь.\nДве наши судьбы в одну сплелись.\n\n[Куплет 2]\nИскры улыбки в любимых глазах.\nСчастье читаю на твоих губах.\nПтицы поют для тебя в небесах.\nВремя застыло на наших часах.\nВместе с тобой мы построим мечту.\nТы ценишь верность, а я чистоту.\n\n[Припев]\nТы только моя, мой безоблачный свет.\nВ целой вселенной тебя краше нет.\nСловно весна посреди зимних дней.\nС каждой минутой люблю всё сильней.\nТы мой покой, мой причал, моя высь.\nДве наши судьбы в одну сплелись.\n\n[Бридж]\nТам, где звучит твой чарующий смех,\nТы для меня остаёшься лучше всех.\nЗвёзды рисуют твой силуэт,\nДаря нам этот волшебный рассвет.\n\n[Припев]\nТы только моя, мой безоблачный свет.\nВ целой вселенной тебя краше нет,\nСловно весна посреди зимних дней.\nС каждой минутой люблю всё сильней.\nТы мой покой, мой причал, моя высь.\nДве наши судьбы в одну сплелись.\nМой яркий свет красивее всех навсегда."}, {"i": "54", "t": "Ветер знает", "s": "text", "l": "[Куплет 1]\nСтарый флюгер на крыше скрипит в темноте.\nПыльный хайвей потерян в чужой пустоте.\nТы считаешь монеты, минуты и дни,\nНо в карманах твоих остаются одни\nЛишь обрывки газет да дорожная пыль.\nГде здесь глупая сказка? А где была быль?\nИ чем дальше дорога, тем тише ответ.\nСколько прожито лет? Покоя всё нет.\n\n[Припев]\nОтвет мой, друг, знает только ветер.\nОн гуляет один по пустой планете.\nТы не ищи его в толстых домах.\nОн прячется где-то в твоих же домах.\nДа, ответ знает только лишь ветер.\nТолько ветер.\n\n[Куплет 2]\nПроповедник с трибуны кричит о грехах.\nПолитик торгует надежды в стихах.\nА на лицах бродят толпы слепых.\nОни ищут вождей среди точно таких.\nНо струна на гитаре продолжит звенеть,\nДаже если нам некому больше здесь петь.\nВ каждом окне догорает свеча.\nКто-то ищет спасение, но ищет не там.\n\n[Припев]\nОтвет мой, друг, знает только ветер.\nОн гуляет один по пустой планете.\nТы не ищи его в толстых домах.\nОн прячется где-то в твоих же домах.\nДа. Ответ знает только лишь ветер.\nТолько ветер.\n\n[Бридж]\nСмысл жизни не в том, чтоб дойти до конца,\nИ не в маске пустой, что сорвали с лица,\nА он в случайном глотке ледяного ручья,\nВ тихой песне ночной, что опять ничья.\n\n[Припев]\nОтвет мой, друг, знает только ветер.\nОн гуляет один по пустой планете.\nТы не ищи его в толстых домах.\nОн прячется где-то в твоих же домах.\nДа, ответ знает только лишь ветер.\nДа, ответ знает только лишь ветер.\n\n[Аутро]\nИграет старый друг на гармошке своей.\nСреди этих фальшивых пустых скоростей\nВетер крутит колёса, уносит года.\nМы плывём в никуда.\nДа плывём никуда."}, {"i": "55", "t": "За брата горой", "s": "text", "l": "[Куплет 1]\nУ нашего костра всегда тепло.\nЯ с детства помню, мы одна порода.\nИ сколько бы воды с неба ни утекло,\nСемья моя, надежда и свобода.\nЯ братов по плечу всегда узнаю,\nЗа них молюсь и в жизни встрою.\nВнутри себя я доблесть взращиваю,\nЧтоб крепким быть, когда не на краю.\n\n[Припев]\nЗа брата горой, за семью до конца.\nПусть честью сияют сегодня сердца.\nКто доблесть хранит, тот мне брат по душе.\nМы путь свой нашли на крутом вираже.\nХочу быть примером, опорой для всех.\nГде правда и вера, там ждёт нас успех.\nСемья — это те, кто не бросит в беде,\nКто верен себе всегда и везде.\n\n[Куплет 2]\nНо брат не только тот, в ком наша кровь,\nА тот, в ком совесть чище, чем родник.\nКто дарит миру свет и ищет вновь\nТот смысл, что в сердце праведном возник.\nВ каждом из нас божественный исток,\nСвятая чистота из зов небес.\nПусть каждый будет в правде, не одинок.\nВедь в каждом человеке мир чудес.\n\n[Бридж]\nСвященный долг ведёт нас к правде внутренней.\nВ поступках наших истина видна.\nНи в словах красивых, ни в молитве утренней,\nА в том, как жизнь на совесть прожита.\nЯ выбираю путь прямой и праведный,\nЧтобы по совести мысли и дела.\nМой кодекс чести вечный, незыблемый,\nЧтобы искра божья в нас всегда жила.\n\n[Припев]\nЗа брата горой, за семью до конца.\nПусть честью сияют сегодня сердца.\nКто доблесть хранит, тот мне брат по душе.\nМы путь свой нашли на крутом вираже.\nХочу быть примером, опорой для всех.\nГде правда и вера, там ждёт нас успех.\nСемья — это те, кто не бросит в беде,\nКто верен себе всегда и везде.\nПусть светит правда в каждом деле.\nБрат за брата по совести, по правде."}, {"i": "56", "t": "Пыль на ботинках", "s": "text", "l": "[Куплет 1]\nСтрелки часов сошли с ума, бегут назад.\nВ кармане старый плащ, в руках один билет.\nТы говорила, любовь — это хрустальный мост,\nНо дождь его смыл, и моста больше нет.\nЯ искал тебя в книгах между честных строк,\nНо нашёл только ветер и дорожный песок.\n\n[Припев]\nПыль на ботинках, на сердце грусть,\nНо я улыбнусь и дальше двинусь в путь.\nЛа-ла-ла, улетели птицы.\nЛа-ла-ла. Перевёрнута страница.\nЛюбовь ушла. Ну и пусть, танцуй со мной,\nРазгоняя грусть. Эй, скрипач, поддай огня.\nСвобода снова выбрала меня.\nЛа-ла-ла.\nИ пусть сердце болит, пыль на ботинках,\nА душа летит.\n\n[Куплет 2]\nНа углу старик продавал каштаны и газеты.\nСпросил меня парень: «Где твоя Джульетта?»\nЯ сказал: уплыла на большом корабле,\nИщет новые звёзды на старой земле.\nФилософы спорят в дешёвом баре,\nКто виноват и куда нам идти.\nА я сжигаю письма в осеннем пожаре,\nУчусь без неё себя снова найти.\n\n[Припев]\nЛа-ла-ла. Улетели птицы, ла-ла-ла.\nПеревёрнута страница, любовь ушла.\nНу и пусть танцуй со мной, разгоняя грусть.\nЭй, скрипач, подавай огня.\nСвобода снова выбрала меня.\nИ пусть сердце болит, пыль на ботинках,\nА душа летит.\n\n[Бридж]\nМы тратим полжизни, чтоб склеить зеркало.\nНо кто сказал, что прекрасен лишь тот, кто не падал.\nПотеря не пустота, а место для чудес.\nСмотри, как синеет над нами небесный навес.\n\n[Припев]\nЛа-ла-ла, улетели птицы.\nЛа-ла-ла. Перевёрнута страница, любовь ушла.\nНу и пусть танцуй со мной.\nРазгоняя грусть. Эй, скрипач, поддай огня.\nСвобода снова выбрала меня.\nИ пусть сердце болит, пыль на ботинках,\nА душа летит.\nПросто танцуй.\nПыль на ботинках, свобода.\nЛа-ла-ла."}, {"i": "57", "t": "Чистое сердце под дырявым зонтом", "s": "text", "l": "[Куплет 1]\nПыль, дорога села на старых моих сапогах.\nВремя крутит часы, зажимая песчинку в горстях.\nЯ искал этот свет в лабиринтах чужих городов,\nГде торговцы святынями рушат основы основ.\nНо когда утихает полуночный бешеный лай,\nТы приходишь ко мне, открывая потерянный край.\n\n[Припев]\nИ когда твоё сердце прозрачно, как утренний лёд,\nВысший шёпот беззвучно на землю росою падёт.\nЭта вечность глядит на нас.\nЭто вечность поёт для нас.\n\n[Куплет 2]\nА в мире столько судей, готовых швырнуть свой кирпич.\nКаждый хочет учить, но никто не способен постичь,\nКак рождается мир из простой и невинной слезы,\nКак смывает грехи этот гром предпасхальной грозы.\nЛюди ищут ключи в сундуках со старинным добром.\nНу а нам повезло. Мы стоим под дырявым зонтом.\n\n[Припев]\nИ когда твоё сердце прозрачно, как утренний лёд,\nВысший шёпот беззвучно на землю росою упадёт.\nЭта вечность глядит на нас.\nЭта вечность поёт для нас.\n\n[Бридж]\nО, любовь — это не сделка, не флаг на кирпичной стене.\nЭто тихая гавань, горящая в вечном огне.\nКто очистил свой разум от злобы и мелких обид,\nТого небо прощает, того ангел в пути сохранит.\nМы уходим в рассвет, где стираются тени и страх.\nС этой чистой молитвой на бледных сухих губах.\n\n[Припев]\nИ когда твоё сердце прозрачно, как утренний лёд,\nВысший шёпот беззвучно на землю росою упадёт.\nЭта вечность глядит на нас.\nЭта вечность поёт для нас.\nПросто чистый холст, просто вечный дождь.\nБлагословение в пути."}, {"i": "58", "t": "Чужая радость", "s": "text", "l": "[Куплет 1]\nЛистает ночь промокшие кварталы.\nВ салоне тихо светит монитор.\nЯ знаю, ты от прошлого устала,\nИ наш с тобой окончен разговор.\nОпять курю, вовсю летят недели.\nУ каждого теперь своя судьба.\nМы то, что так хотели, не сберегли.\nИ в городе чужом бегут года.\n\n[Припев]\nНо трек машине крутит по кольцу,\nИ мысли снова рвутся в небеса.\nИ капли дождевые по стеклу\nНапомнят мне твои глаза.\nНу как ты там, моя чужая радость?\nВ каком раю чужие руки греешь?\nОт нашей памяти осталась только малость.\nНо ты ведь тоже ни о чём не жалеешь.\nНу как ты там, моя чужая радость?\nА за окном опять летят дороги.\nТы для меня святая моя слабость,\nОставленная Богом на пороге.\n\n[Куплет 2]\nДрузья твердят: «Забудь, со всеми было,\nНалей 100 грамм и просто улыбнись».\nНо время ни черта не излечило.\nТакая вот хмельная наша жизнь.\nПускай другой тебя целует в губы\nИ дарит по весне твои цветы.\nЯ не сужу его, я не был грубым,\nВедь главным в моей жизни была ты.\n\n[Припев]\nНо трек машине крутит по кольцу,\nИ мысли снова рвутся в небеса.\nИ капли дождевые по стеклу\nНапомнят мне твои глаза.\nА ну как ты там, моя чужая радость?\nВ каком раю чужие руки греешь?\nОт нашей памяти осталась только малость.\nНо ты ведь тоже ни о чём не жалеешь.\nНу как ты там, моя чужая радость?\nА за окном опять летят дороги.\nТы для меня святая моя слабость.\nОставленная Богом на пороге.\n\n[Аутро]\nА за окном рассвет смывает звёзды.\nИ этот город начинает жить.\nНаверное, изменять что-либо поздно,\nНо я тебя не прекращал любить.\nНу как ты там, моя чужая радость?\nТы для меня святая моя слабость,\nОставленная Богом на пороге."}, {"i": "59", "t": "Исповедь сына", "s": "text", "l": "[Куплет 1]\nЗнаешь, мам, я долго молчал,\nНо сегодня хочу сказать тебе всё.\nПросто послушай.\nЯ помню детство своё, где всегда был один\nСреди серых дворов и холодных витрин.\nМне казалось тогда, что я лишний в судьбе,\nЧто совсем не нужен дорогой тебе.\nТы искала себя, уходила во тьму.\nОставляла меня замерзать одному.\nЯ не знал, почему не обнимешь в ответ.\nТы гасила на ночь сама в своей комнате свет.\nБыло больно и зло за несказанных слов,\nЗа пустые места у моих детских снов.\n\n[Припев]\nНо я всё отпустил. Слышишь, мама? Прости.\nНам обиду нет смысла нести.\nЯ люблю тебя сильно.\nО, сквозь годы и боль.\nО, для меня твоё имя — святая пароль.\nТы дала мне эту жизнь.\nПусть было темно,\nЯ тебя за всё прощаю, мама.\n\n[Куплет 2]\nОчень давно я подрос и понял:\nТы тоже росла.\nИ не так уж легко твоя доля была.\nТы ломалась как все, совершала грехи\nИ от этой тоски сочиняла стихи.\nЯ не судья тебе, мама.\nЯ просто твой сын\nИз твоей теплоты и холодный дым.\nЯ обиды сожгу, сосчитаю до 100.\nПосмотри на душе — вновь царит чистота.\nПусть мы в прошлом с тобой не нашли общий мост.\nПуть обратно к тебе оказался так прост.\n\n[Припев]\nНо я всё отпустил. Слышишь, мама? Прости.\nНам обиду нет смысла нести.\nЯ люблю тебя сильно.\nСквозь годы и боль для меня твоё имя.\nСвятая пароль, ты дала мне эту жизнь.\nПусть и было темно.\nЯ тебя за всё прощаю, мама.\n\n[Аутро]\nОчень давно.\nВремя лечит, мамуль.\nВсё нормально.\nГлавное, береги себя.\nЯ люблю тебя."}, {"i": "60", "t": "Далеко от дома", "s": "text", "l": "[Куплет 1]\nРассвет тучи, утренняя гроза.\nЯ с чистым сердцем открываю глаза.\nОдин чемодан в кармане, верный расчёт.\nЯ знаю точно, жизнь готовит взлёт.\nТам позади остался старый причал.\nЯ новый путь осознанно выбирал.\nМне есть куда идти. Я вижу свет ночи.\nИ в новый дом судьба уже вручает ключи.\n\n[Припев]\nДалеко от дома — это не беда.\nЗагорится в небе новая звезда.\nШаг вперёд, браток, и ни шагу назад.\nСмотрим только в завтра, забывая ад.\nВ городе чужом руки, ноги целы —\nЗначит, поживём.\n\n[Куплет 2]\nНовый перрон, полный вокзал.\nЯ лучшее будущее себе предсказал.\nОткрыты двери, возводятся мосты.\nМои надежды, как весенние цветы.\nЯ улыбнусь и хриплым басом запою.\nЯ твёрдо на ногах в этом мире стою.\nПрошлое ушло, но завтрашний день открыт.\nКаждый шаг вперёд уверенно звучит.\n\n[Бридж]\nПусть говорят, что трудно с нуля начинать.\nМою породу никому не сломать.\nМой выбор конечен, характер мой силён.\nЯ докажу всем, что я для счастья рождён.\n\n[Припев]\nДалеко от дома — это не беда.\nЗагорится в небе новая звезда.\nШаг вперёд, браток, и ни шагу назад.\nСмотрим только в завтра, забывая ад.\nВ городе чужом руки, ноги целы —\nЗначит, поживём.\nНазад дороги нет.\nИ не нужно жалеть.\nЯ всё смогу."}, {"i": "61", "t": "Эхо нашего двора", "s": "text", "l": "[Куплет 1]\nГде же вы все сейчас, ребята?\nПомнишь тот май, помнишь тот свет?\nНам по 16. Забот ещё нет.\nШум за окном, смех до темна.\nПервая радость. Бокал без вина.\nТёплый асфальт, старые качели.\nВ плеере песня, в сердце апрель.\nБыстро росла наша среда.\nДумали, это уже навсегда.\n\n[Припев]\nА время летит тик-так, тик-так.\nИ каждый из нас ушёл в свой мрак.\nНо помнит наш двор, но помнит наш дом,\nКак весело нам было вдвоём.\nРазвела судьба по разным путям.\nСлова улетели к чужим берегам.\nНо в сердце горит тот старый костёр,\nЧто греет меня до сих пор.\n\n[Куплет 2]\nНомера в телефонах стёрты давно.\nЖизнь закрутилась, будто кино.\nТолько во сне я вижу опять\nЛица людей, что устал я искать.\nГород шумит, каждый в делах.\nДетство осталось только в словах.\nКто-то родитель, кто-то босс.\nЖизнь задаёт слишком сложный вопрос.\nНо если случайно встречу в толпе,\nСердце напомнит мне о тебе.\nПросто улыбка, просто привет.\nВспыхнет из прошлого ласковый свет.\n\n[Припев]\nА время летит тик-так, тик-так.\nИ каждый из нас ушёл в свой мрак.\nНо помнит наш двор, но помнит наш дом,\nКак весело нам было вдвоём.\nРазвела судьба по разным путям.\nСлова улетели к чужим берегам.\nНо в сердце горит тот старый костёр,\nЧто греет меня до сих пор.\n\n[Аутро]\nЛавочки старой сменился окрас.\nНовые люди гуляют сейчас.\nТолько сквозь годы я слышу в тиши\nГолос далёкой, но близкой души.\nА время летит тик-так, тик-так.\nИ каждый из нас ушёл в свой мрак.\nНо помнит наш двор, но помнит наш дом,\nКак весело нам было вдвоём.\nРазвела судьба по разным путям.\nСлова улетели к чужим берегам.\nНо в сердце горит тот старый костёр,\nЧто греет меня до сих пор.\nУлетели года.\nНаш старый дом."}, {"i": "62", "t": "Моя родная", "s": "text", "l": "[Куплет 1]\nПомню вокзал и холодный перрон.\nДождь за спиной, впереди только сон.\nБыл чемодан у нас один на двоих.\nИ целый мир был впереди.\nМы не знали, куда нас ведёт этот путь,\nНо решили назад уже не свернуть.\nТы держала меня за ладонь,\nИ в душе загорался огонь.\n\n[Припев]\nКаждый пройденный шаг\nМы делились с тобой и держались вдвоём.\nПусть менялись ветра и смеялись дома,\nНаша крепость жива, испытание прошла.\nЧерез тысячи дней, через мили дорог\nЯ храню этот свет среди бури тревог.\n\n[Куплет 2]\nМы жили скромно, но верили вновь,\nЧто главное в доме — тепло и любовь.\nПорой не хватало ни сил, ни денег.\nНо рядом с тобой становилось теплее.\nКто-то уходил, кто-то нас забывал.\nМир то поднимал нас, то снова ломал.\nНо я точно знал, среди всех этих дней\nТы мой дом, и я возвращаюсь к тебе.\n\n[Припев]\nКаждый пройденный шаг\nМы делились с тобой и держались вдвоём.\nПусть менялись ветра и сменялись дома.\nНаша крепость жива. Испытание прошла.\nЧерез тысячи дней, через мили дорог\nЯ храню этот свет среди бури тревог.\n\n[Бридж]\nЕсли бы жизнь повернула назад,\nЯ выбрал бы снова тот самый вокзал,\nТот дождь, тот чемодан, тот трудный маршрут,\nГде верные руки меня берегут.\n\n[Припев]\nКаждый пройденный шаг\nМы делились с тобой и держались вдвоём.\nЧерез тысячи дней, через мили дорог\nЯ храню этот свет среди бури тревог\nЧерез мили дорог.\nМоя рука держит твою в ответ."}, {"i": "63", "t": "Тихое имя", "s": "text", "l": "[Куплет 1]\nСтарый асфальт остывает в потьмах.\nПыль вековых дорог на моих плечах.\nВетер свистит о потерях в пустых каньонах.\nМир замерзает в своих холодных законах.\nЯ видел, как рушили стены и гасли огни.\nИ в страхе шептал: «А творец меня помяни».\nКогда темнота подступала к самому сердцу,\nИ негде во всей вселенной было согреться.\n\n[Припев]\nСквозь грохот грозы и шёпот глухих морей\nТы звал меня тихим именем средь людей.\nПусть был пропитан болью, обманом, разлукой,\nНо в каждом шаге ты держал меня за руку\nКрепко, как держит отец своего дитя.\nСквозь ярость штормов над бездной меня ведёшь.\n\n[Куплет 2]\nИуды смеялись, бросая камни во след.\nЖизнь обещала дешёвый фальшивый свет.\nСудьба проверяла на прочность мою броню.\nЯ падал лицом в дорожную эту стерню.\nНо каждый раз, когда компас сбивался с пути\nИ разум твердил, что дальше нельзя идти,\nЯ чувствовал силу, что выше земных судов,\nЗащиту Творца.\n\n[Припев]\nПосреди ядовитых слов, сквозь грохот грозы\nИ шёпот глухих морей\nТы звал меня тихим именем средь людей.\nПуть был пропитан болью, обманом, разлукой,\nНо в каждом шаге ты держал меня за руку.\nКрепко, как держит отец своего дитя.\nСквозь ярость штормов над бездной меня ведёшь.\n\n[Бридж]\nПусть рушатся троны и плачут гитарные струны.\nВся жизнь — это лишь колесо изменчивой фортуны.\nНо выше законов земли, над суетой дорог\nМеня хранил мой Создатель, мой вечный Бог.\nВ огне испытаний сгорала пустая шелуха,\nИ песня моя становилась чиста и тиха.\nТеперь я смотрю на пройденный этот маршрут,\nГде ветры больше меня не гнут.\nЯ знаю, кто спас меня в самый отчаянный час.\nЧто пламя любви в моей груди не погас.\nДорога бежит на закат. Исчезаем вдали.\nНо мы этот путь вдвоём до конца прошли.\nДа, в каждом шаге ты держал меня крепко сквозь бури дым.\nРука в руке до самого дома."}, {"i": "64", "t": "Ты ушла в небеса", "s": "text", "l": "[Куплет 1]\nТвои ключи на полке до сих пор лежат.\nЧасы на нашей кухне третий год спешат.\nЯ открываю окна, но в квартире дым.\nЯ не умею в этом мире быть один.\nТвой лёгкий шарф на стуле пахнет тишиной.\nТы просто улетела, не простившись со мной.\nЗабытый чай остыл и в горле горький ком.\nМой самый близкий ангел стал чужим дождём.\n\n[Припев]\nИ время бьёт по рёбрам, замёрзли часы.\nНо ты всё выжгла, разломаны мосты,\nИ в зеркалах пусты.\nБольше нет твоей манящей грозы.\nТы ушла в небеса, оставив мне только боль.\nНа моих глазах слёзы, на ранах соль.\nНебо, верни её или забери меня.\nВ этом холодном мире больше нет огня.\nБез тебя моё сердце — просто кусок льда.\n\n[Куплет 2]\nЯ ненавижу цифры на двое бледне.\nИ это чёрный мрамор в дикой пустоте.\nДрузья твердят: «Забудь, братуха, время лечит»,\nНо время только давит грузами на плечи.\nЯ соберу рубли, куплю в киоске розы.\nПускай умоют их мои дурные слёзы,\nПоставлю у плиты, затянусь сильнее.\nЯ без тебя, родная, с каждым днём черствею.\nИ каждый вечер — один и тот же замкнутый круг.\nЯ слышу шаги. Но это просто ветра стук.\nПрости меня за всё.\n\n[Припев]\nТы ушла в небеса, оставив мне только боль.\nНа моих глазах слёзы, на ранах соль.\nНебо, верни её или забери меня.\nВ этом холодном мире больше нет огня.\nБез тебя моё сердце — просто кусок льда."}, {"i": "65", "t": "Посмотри человеку в глаза", "s": "text", "l": "[Куплет 1]\nЯ включаю экран, там опять чьи-то слёзы и дым.\nЭтот мир постепенно становится просто чужим.\nМы бежим по делам, наступая на чьи-то мечты.\nИ в толпе городов слишком много земной пустоты.\nЯ листаю звонки, номера, где никто не ответит.\nВместо тёплых домов — ледяной пронизывающий ветер.\n\n[Припев]\nРасскажи мне, откуда в настолько глухой нелюбви?\nМы же люди. Ладонь мою крепче сожми.\nКуда мы идём? Что случилось со всеми нами?\nЗачем этот ад мы вокруг создаём своими руками?\nГде наша открытость? Простая людская забота.\nМы ищем спасение, но заперты все ворота.\nОстановись, человек, посмотри человеку в глаза.\nПока ещё светит солнце, пока не пошла гроза.\n\n[Куплет 2]\nРаньше было легко поделиться последним куском,\nА теперь каждый дом обнесён трёхметровым замком.\nМы боимся обнять, мы боимся сказать «помогу».\nОставляя тонуть чью-то душу на том берегу,\nГде спасительный свет, где тепло, что давали нам мамы.\nПочему на экранах и в мыслях сплошные драмы?\n\n[Припев]\nРасскажи мне, откуда в настолько глухой нелюбви?\nМы же люди. Ладонь мою крепче сожми.\nКуда мы идём? Что случилось со всеми нами?\nЗачем это так? Мы вокруг создаём своими руками.\nГде наша открытость, простая людская забота?\nМы ищем спасение, но заперты все ворота.\nОстановись, человек. Посмотри человеку в глаза.\nПока ещё светит солнце, пока не пошла гроза.\n\n[Бридж]\nЧеловечность не купишь в сети за рубли или доллары.\nМы разрушили всё, что веками дышало и дорого.\nНо я верю, прорвёмся. Начнём потихоньку с себя.\nПросто руку подай. Нам без этого выжить нельзя.\n\n[Припев]\nКуда мы идём? Что случилось со всеми нами?\nЗачем этот ад мы вокруг создаём своими руками?\nГде наша открытость, простая людская забота?\nМы ищем спасение, но заперты все ворота.\nО, остановись, человек. Посмотри человеку в глаза.\nПока ещё светит солнце.\nПока не пошла гроза, посмотри мне в глаза,\nЧто случилось со всеми нами.\nКуда мы идём?"}, {"i": "66", "t": "Поверить так сложно", "s": "text"}, {"i": "67", "t": "Порой судьба даёт нам шанс", "s": "text", "l": "Судьба порой нам выдаёт прекрасный шанс,\nА мы его не ценим — полагаемся на чудо.\nНа Небесах уж подведён давно баланс,\nА мы проходим мимо изумруда.\n\nСудьба даёт нам шансы регулярно,\nНо мы их принимаем не всегда.\nГотовы потерять мы безвозвратно\nНаграду за прошедшие года?\nНе видим мы порой вокруг те знаки,\nЧто свыше нам даются иногда.\n\nВедь мне судьба давала много раз\nТот самый важный для меня шанс.\nНе слыша из уст твоих отказ,\nНо всегда текли слёзы с твоих глаз.\nКаждый вечер…"}, {"i": "68", "t": "Treasure your time", "s": "text", "l": "[Verse 1]\nValue time, while the sun still shines on you,\nWhile the road is long, you stand in the land.\nThat I'd buy you lose —\nThose who walk with you and look honestly after.\nFor life is not an eternal fleeting moment,\nBut you're only taking.\nWe stake so much without counting the loss.\nOur wisdom comes only to those who have fallen like gray ash.\nWhere the soul is tired and cracks appear like scars,\nWe understand the main thing:\nStanding is more important than stubbornness.\nNo matter how much we were beaten, we still rose,\nAnd even in the blackest nights, we try to hope.\nLife may not promise a gentle wind,\nBut the sun shines for all who mark their own.\n\n[Chorus]\nValue time, while the sun still shines on you,\nWhile the moment hasn't been swallowed by cigarette smoke.\nValue words, actions, your steps, and your answers,\nWhile you are honest with your heart —\nYou are stronger than any victory.\nAnd if you suddenly grow tired, the night comes harsh,\nRemember: even clouds cannot hide everything again.\nLife is not about fatigue, it's about those who could pass through the storm of truth\nWithout selling God.\nYour path is not drawn by a stroke of a pen,\nThere's blood on your hand.\nBut those who walk their own road — they are their own.\n\n[Chorus]\nFollow time, while the sun still shines on you,\nWhile the unextinguished have a light,\nAnd your soul still burns.\nValue every daily moment —\nIt's precious like a vow.\nAs long as you live consciously,\nYou are wise and therefore strong.\n\n[Outro]\nFollow time, while the sun still shines on you."}, {"i": "69", "t": "НЕ ЛЕЧИТЕ МЕНЯ", "s": "text"}, {"i": "70", "t": "Крик в тишине", "s": "text", "l": "[Куплет 1]\nСтены молчат, город не спит,\nА где-то внутри что-то ещё горит.\nХолодный камень, тусклый свет.\nДень за днём, и ответа нет.\nСерые лица, пустые сны.\nЯ всё ещё жду своей весны.\nНо что-то живёт, что-то во мне не даёт\nРаствориться в этой тишине.\nХочет на волю, хочет лететь.\nТо, что внутри, не сможет умереть.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине среди старых снов.\nПустота внутри, но я всё ещё жив.\nИщу тот момент, что когда-то забыл.\nКрик-крик в тишине. Крик-крик в тишине.\nЯ ещё жив. Я ещё жив.\nИ крик в тишине: «Не отпускай меня.\nТо, что внутри, не умрёт никогда».\n\n[Куплет 2]\nЛюди бегут, опустив глаза.\nКаждый спешит неизвестно куда.\nТысячи лиц растворяет толпа.\nМожет, не только болит у меня.\nЯ ищу знак среди этих огней.\nТот самый миг, когда был настоящим.\nЖизнью своей… что-то живёт,\nЧто-то во мне не даёт\nРаствориться в этой тишине.\nХочет на волю, хочет лететь.\nТо, что внутри, не сможет умереть.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине среди старых снов.\nПустота внутри, но я всё ещё жив.\nИщу тот момент, что когда-то забыл.\nКрик-крик в тишине. Крик в тишине.\nЯ ещё жив. Я ещё жив.\nИ крик в тишине: «Слышишь меня?\nТо, что внутри, не умрёт никогда».\n\n[Бридж]\nЗакрою глаза — там всё ещё свет.\nПусть вокруг темно, но выхода нет?\nНет, я найду его сквозь стены,\nСквозь ночь, сквозь этот сон.\nЯ слышу внутри свой настоящий голос.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине выше старых оков.\nПустота уйдёт, если свет не гасить.\nЯ нашёл тот момент. Я хочу снова жить.\nКрик в тишине. Крик в тишине.\nЯ ещё жив. Я ещё жив.\nТо, что внутри, не убить, не стереть.\nТо, что внутри, не сможет умереть."}, {"i": "71", "t": "Не тех мы ценим — OutShadow feat RUVSON", "s": "text", "l": "[Куплет 1]\nМы часто путаем салюты с маяком\nИ в дом зовём гостей, кто с нами не знаком.\nНакрыт богатый стол, вино рекой течёт\nДля тех, кто нас предаст, когда беда прижмёт.\nМы ищем яркий блеск в дешёвой мишуре,\nЗабыв про тех, кто грел нам руки в январе.\nКидаем фразы тем, кто их не сохранит.\nА преданность в углу, как старый пёс, молчит.\n\n[Припев]\nНе тех мы ценим, пока сердце ровно бьётся.\nНе тем мы дарим свет, что в нас по капле льётся.\nБежим за теми, кто при первой буре сгинет.\nА тех, кто нас любил, мы оставляем в спину.\nПриходит час, когда часы застынут вдруг.\nИ ты поймёшь, кто пассажир, а кто был друг.\nНо поздно пить боржоми. Перрон уже пустой.\nМы платим одиночеством за выбор свой.\n\n[Куплет 2]\nМы обижаем тех, кто мог бы всё простить.\nНам кажется, успеем, можно не спешить.\nМол, позвоню потом, заеду через год.\nНо жизнь выписывает нам другой расход.\nКогда ты на коне, вокруг толпа друзей,\nДрузья клянутся в верности до самых корней.\nНо стоит оступиться, грязь лицом поймать —\nОстанется лишь тот, кого привык гнать.\n\n[Припев]\nНе тех мы ценим, пока сердце ровно бьётся.\nНе тем мы дарим свет, что в нас по капле льётся.\nБежим за теми, кто при первой буре сгинет.\nА тех, кто нас любил, мы оставляем в спину.\nПриходит час, когда часы застынут вдруг.\nИ ты поймёшь, кто пассажир, а кто был друг.\nНо поздно пить боржоми. Перрон уже пустой.\nМы платим одиночеством за выбор свой.\n\n[Куплет 3]\nСмотришь телефон, а там одни контакты.\nНи душ родных, ни правды. Голые лишь факты.\nХотелось бы вернуть, сказать всего два слова:\n«Прости меня», — но там замки и там засовы.\nХолодный мрамор плит не слышит оправданий.\nВот так и тонем мы в болоте опозданий.\n\n[Припев]\nНе тех мы ценим. Пока сердце ровно бьётся,\nНе тем мы дарим свет, что в нас пока льётся.\nБежим за теми, кто при первой буре сгинет.\nА тех, кто нас любил, мы оставляем в спину.\nПриходит час, когда часы застынут вдруг.\nИ ты поймёшь, где просто тень, а где был друг.\nБерегите своих, пока они есть, пока время есть."}, {"i": "72", "t": "Начать сначала — OutShadow feat. RUVSON", "s": "text", "l": "[Куплет 1]\nКогда туман закрыл твой горизонт\nИ кажется, что проигран этот фронт,\nВнутри затих последний звук надежды,\nИ мир не станет как прежде.\nНо именно в тиши ты крепче стал.\nТы не сломался, ты просто перестал\nЖдать милости от неба и судьбы.\nТы рождён идти, а не стоять в тени.\n\n[Припев]\nКогда накрыла и нечем дышать —\nПопробуй просто встать и заново начать.\nНе жди чудес, не ищи лёгкий путь\nВ своей же слабости. Не дай себе тонуть.\nТам, где все видят стену, ты увидишь дверь.\nИ даже сквозь страх всё равно в себя верь.\n\n[Куплет 2]\nОшибки не клеймо, они твои уроки.\nВ них зашифрованы невидимые строки.\nНе бойся оступиться, бойся не начать,\nВедь только в битве можно крепче стать.\nПусть боль тебя куёт, как сталь в живом огне.\nТы истину найдёшь в этой глубине.\nСомнения не цепь, а просто лишний груз.\nСбрось их со скалы, почувствуй жизнь и вкус.\n\n[Припев]\nКогда весь мир молчит, ты громче закричи.\nГлухой стене всегда найдёшь ключи.\nНе жди счастливый шанс. Ты сам его создай.\nСквозь тернии страха шагай и не сдавай.\nКогда накрыла и нечем дышать —\nПопробуй просто встать и заново начать.\nНе жди чудес, не ищи лёгкий путь\nВ своей же слабости. Не дай себе тонуть.\nТам, где все видят стену, ты увидишь дверь.\nИ даже сквозь страх всё равно в себя верь.\nТам, где другие гаснут, ты гори."}, {"i": "73", "t": "Когда теряем — OutShadow feat RUVSON", "s": "text", "l": "[Куплет 1]\nНовый вечер в кофейне. Густой туман растворяет дома.\nЯ по кварталам брожу, где воспоминания сводят с ума,\nГде тёплой весной душу накрывает зима.\nГде жизнь летела стрелой мимо даты, мимо нас.\nМы жгли бумажки, забывая, зачем мы живём.\nИ казалось, всегда впереди ещё звучит долг.\nТолько время в долг ничего не даёт.\nИ вдруг на сердце ложится холодный лёд.\n\n[Припев]\nМы учимся ценить, когда теряем,\nКогда за дверью гаснет чей-то свет.\nМы машем вслед ушедшим поездам,\nПытаясь вымолить у прошлого ответ.\nМы учимся любить, когда всё стыло,\nКогда в ладонях пепел, а не сталь.\nО, если б знать заранее, как будет ныть\nВ душе эта прозрачная печаль.\n\n[Куплет 2]\nНе сказал, не обнял. Не успел.\nЭто вечный мотив.\nВсё берёг на после.\nСердце для других не отворил.\nМы сражаемся с тенью,\nСгораем в пустых мелочах.\nИ не видно, как иней садится на наших плечах.\nТолько счастье не в блеске витрины,\nНе в пачках купюр,\nА в тихой правде родных, в их тепле среди бурь.\nНо мы ценим лишь то, что уже невозможно вернуть,\nПродолжая свой длинный и часто бессмысленный путь.\n\n[Припев]\nМы учимся ценить, когда теряем,\nКогда за дверью гаснет чей-то свет.\nМы машем вслед ушедшим поездам,\nПытаясь вымолить у прошлого ответ.\nМы учимся любить, когда всё стыло,\nКогда в ладонях пепел, а не сталь.\nО, если б знать заранее, как будет ныть\nВ душе эта прозрачная печаль.\n\n[Бридж]\nПозвони старикам, обними,\nПока бьётся пульс.\nПусть обиды пройдут.\nЯ за это сегодня молюсь,\nПотому что финал у всех песен в итоге один.\nМы остаёмся в памяти эхом забытых имён.\n\n[Припев]\nМы учимся ценить, когда теряем,\nКогда за дверью гаснет чей-то свет.\nМы машем вслед ушедшим поездам,\nПытаясь вымолить у прошлого ответ.\nМы учимся любить, когда всё стыло,\nКогда в ладонях пепел и разбитый хрусталь.\nБеречь бы то, что есть.\nПока мы здесь,\nПока не улетела душа вдаль."}, {"i": "74", "t": "Не жди завтра — RUVSON и OutShadow", "s": "text", "l": "[Куплет 1]\nЗаварит вечер крепкий чай в стакан.\nЗа окнами закружится листва.\nМы всё плывём в придуманном тумане.\nНам кажется, в запасе есть года.\nДостану я с кармана старенький блокнот,\nГде планов будто на столетья ход.\nВсё бережём на после, на потом,\nЗабыв, что жизнь — не стройка, это дом.\n\n[Припев]\nМы откладываем жизнь свою на завтра,\nКак будто время — вечная река.\nНо в этой гонке нет второго старта.\nИ в зеркалах всё больше серебра.\nМы отложить пытаемся на завтра\nТот миг, что ускользает от нас всегда.\nИ в пустоту уходит наша карта.\nИ в них ударят наши года.\n\n[Куплет 2]\nСказать «люблю» успеем, мол, попозже.\nПростить врага когда-нибудь потом.\nА иней всё сильнее бьёт по коже.\nИ холод незаметно входит в дом.\nМы копим вещи, фразы и долги,\nНе замечаем тех, кто возле нас.\nМы пишем жизнь на черновиках,\nОставляя чистовик в чужих руках.\n\n[Припев]\nМы откладываем жизнь свою на завтра,\nКак будто время — вечная река.\nНо в этой гонке нет второго старта,\nИ жизнь уходит тихо сквозь года.\nМы откладываем жизнь\nНа завтра и теряем навсегда.\n\n[Аутро]\nДавай начнём сегодня, без «когда-то».\nПока ещё горит в окне твоя звезда."}, {"i": "75", "t": "Цени время — RUVSON и OutShadow", "s": "text"}, {"i": "76", "t": "Крик в тишине (Remix 2026)", "s": "gip", "l": "[Куплет 1]\nСтены молчат, город не спит,\nА где-то внутри что-то ещё горит.\nХолодный камень, тусклый свет.\nДень за днём, и ответа нет.\nСерые лица, пустые сны.\nЯ всё ещё жду своей весны.\nНо что-то живёт, что-то во мне не даёт\nРаствориться в этой тишине.\nХочет на волю, хочет лететь.\nТо, что внутри, не сможет умереть.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине среди старых снов.\nПустота внутри, но я всё ещё жив.\nИщу тот момент, что когда-то забыл.\nКрик-крик в тишине. Крик-крик в тишине.\nЯ ещё жив. Я ещё жив.\nИ крик в тишине: «Не отпускай меня.\nТо, что внутри, не умрёт никогда».\n\n[Куплет 2]\nЛюди бегут, опустив глаза.\nКаждый спешит неизвестно куда.\nТысячи лиц растворяет толпа.\nМожет, не только болит у меня.\nЯ ищу знак среди этих огней.\nТот самый миг, когда был настоящим.\nЖизнью своей… что-то живёт,\nЧто-то во мне не даёт\nРаствориться в этой тишине.\nХочет на волю, хочет лететь.\nТо, что внутри, не сможет умереть.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине среди старых снов.\nПустота внутри, но я всё ещё жив.\nИщу тот момент, что когда-то забыл.\nКрик-крик в тишине. Крик в тишине.\nЯ ещё жив. Я ещё жив.\nИ крик в тишине: «Слышишь меня?\nТо, что внутри, не умрёт никогда».\n\n[Бридж]\nЗакрою глаза — там всё ещё свет.\nПусть вокруг темно, но выхода нет?\nНет, я найду его сквозь стены,\nСквозь ночь, сквозь этот сон.\nЯ слышу внутри свой настоящий голос.\n\n[Припев]\nКрик в тишине, без звука, без слов.\nКрик в тишине выше старых оков.\nПустота уйдёт, если свет не гасить.\nЯ нашёл тот момент. Я хочу снова жить.\nКрик в тишине. Крик в тишине.\nЯ ещё жив. Я ещё жив.\nТо, что внутри, не убить, не стереть.\nТо, что внутри, не сможет умереть."}, {"i": "77", "t": "Цени моменты (Remix 2026)", "s": "text", "l": "[Куплет 1]\nМы жжём года, не замечаем,\nВсё ищем то, чего всё нет.\nНо жизнь проходит, не прощая,\nИ каждый день оставит след.\nМы всё спешим, всё догоняем,\nТеряя главное в пути.\nПока мы чувствуем и знаем,\nНам есть зачем ещё идти.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь, не заключить с ним договор.\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк.\n\n[Куплет 2]\nМы ставим всё, не зная ставки,\nИ часто платим за урок.\nНо даже после самой давки\nВсегда останется рывок.\nНе жди, когда наступит завтра.\nНе отдавай себя годам.\nПока внутри ещё есть правда,\nТы выбираешь путь свой сам.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь, не заключить с ним договор.\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк.\n\n[Бридж]\nКогда темно — иди вперёд.\nКогда нет сил — ещё живёшь.\nПока внутри огонь не мёртв,\nТы всё равно своё найдёшь.\n\n[Припев]\nЦени моменты — их не поставить на повтор.\nСо временем, поверь…\nЦени того, кто рядом. Цени свой каждый шаг.\nПока в груди стучит — ты сам себе маяк."}, {"i": "78", "t": "А что если ДА (Remix 2026)", "s": "text"}, {"i": "79", "t": "Остаться человеком (Remix Version)", "s": "text", "l": "[Куплет 1]\nВ метро сегодня снова не протолкнуться.\nТысячи лиц, и у каждого свой маршрут.\nМы учимся мимо друг друга проснуться,\nБоясь прикоснуться — вдруг нас прочтут.\nВ карманах сияют холодные экраны.\nТам счастье в витринах, успех на прокат.\nЧем больше друзей, тем глубже раны.\nИ фраза «нормально» — как заученный факт.\n\n[Припев]\nЭто странный плен —\nОдиночество среди людей.\nВ океане глаз мы теряем своих друзей.\nГромкий смех вокруг, а внутри тишина и лёд.\nТы стоишь в толпе, но никто не зовёт.\nОдиночество в самом центре большой мечты,\nГде стираются смыслы, сжигаются мосты.\nОдиночество, но оно — не ты.\n\n[Куплет 2]\nВ мире масок привычка скрывать,\nКак страшно порой просто жить и дышать.\nМы строим из слов непреступные стены,\nНо жажда тепла подскажет, как верно.\n\n[Припев]\nЭто странный плен —\nОдиночество среди людей.\nВ океане глаз мы теряем своих друзей.\nГромкий смех вокруг, а внутри тишина и лёд.\nТы стоишь в толпе, но никто не зовёт.\nОдиночество в самом центре большой мечты,\nГде стираются смыслы и сжигаются мосты.\n\n[Бридж]\nМы боимся быть слабыми, быть живыми.\nПрячем сердце за ролями и именами.\nЗакрываемся в броню, выходя на бой.\nНо выход не там, где нет нас и покой.\nОн там, где не нужно казаться сильней.\nПросто выдохни.\nТы рядом.\nТы есть.\n\n[Аутро]\nЭто странный плен —\nОдиночество среди людей.\nНо даже в холодной толпе ты можешь быть теплей.\nЕсли холод внутри — не молчи, не беги,\nПросто руку протяни.\nТы не один.\nДаже если вокруг миллионы холодных лиц.\nОдиночество не навсегда внутри.\n\n[Куплет 3]\nРассвет, как стекло. Всё понятно давно.\nЗакрыть своё сердце на ключ — это не мой закон.\nЯ могу стать камнем или стать ветром.\nЯ — своя собственная правда.\nЯ лечу к свету.\nГолос внутри меня жив.\nДыши, будь здесь, в ритме своей жизни.\n\n[Припев]\nОставаться человеком, когда мир давит на грудь.\nОставаться человеком и не свернуть с пути\nСквозь боль и ложь.\nКаждый вдох держит меня, тянет к свету.\nЯ свой собственный бог.\nОставаться человеком.\nОставаться человеком.\n\n[Куплет 4]\nХолод во взглядах, будто мир против нас.\nОни говорят: «Не верь, гасит каждый шанс».\nНо я видел свет там, где нет уже веры.\nСлово — как укрытие, моё перерождение.\nГолос внутри меня жив.\nДыши здесь, в ритме своей жизни.\n\n[Припев]\nОставаться человеком,\nКогда мир давит на грудь.\nОставаться человеком,\nНе свернуть сквозь боль и ложь.\nКаждый вдох держит меня,\nТянет к свету.\nЯ свой собственный бог.\nПусть струны рвутся,\nЯ беру жизнь до края.\nМой дух не сломить, я остаюсь.\nЯ знаю: просто быть собой —\nПросто оставаться человеком.\nСложнее, чем выжить.\nОстаться собой."}, {"i": "80", "t": "А время капает (Remix)", "s": "text"}, {"i": "81", "t": "Сборник Музыки со Смыслом — 2 часа", "s": "shum"}, {"i": "82", "t": "Музыка для души | Сборник Музыки СО СМЫСЛОМ О ЖИЗНИ — 1 час", "s": "shum"}, {"i": "83", "t": "Конструкторы войны", "s": "text", "l": "[Куплет 1]\nЭй, вы, конструкторы войны,\nТворцы орудий и смертей.\nВы за стеной неравны,\nЯ вижу суть ваших затей.\nВам этот мир — всего лишь мяч,\nСтекляшка в опытных руках.\nВы шлёте нас в огонь и плач,\nА сами скрылись в особняках.\nВы лжёте нам в лицо опять,\nМол, в этой бойне есть успех.\nНо я могу вас насквозь взять,\nКак воду в кране.\n\n[Припев]\nВидеть грех чужой рукой,\nВзведён курок.\nПока вы множите доход,\nА в поле, подведя итог,\nСвоя же юность в грязь гниёт.\nВаша ложь, как чёрный дым,\nМы не станем стадом немым.\nЗа чеканом монет — пустота,\nЗа парадом побед — сирота.\nГрош цена вашим вечным делам,\nЕсли мир вы делите пополам.\nМы запомним всё, мы дождёмся конца,\nКогда смоет грим с вашего лица.\n\n[Куплет 2]\nВы сеете в нас жуткий страх,\nБоясь дарить потомству свет.\nВы гнили пепел на губах,\nДля вас в нас капли крови нет.\nПусть я мал и не учён,\nВы скажете, что смыслит он.\nНо даже Бог ваш возмущён,\nВаш грех за гранью всех времён.\nРазве за золото своё\nКупите вечности покой?\nКогда нагрянет вороньё,\nДуша не выкупится ценой.\nЯ буду ждать, когда к концу\nПридёт ваш час.\n\n[Бридж]\nЯ посмотрю на ту судьбу,\nЧто навсегда укроет вас.\nЯ встану прямо у могилы,\nГде вы найдёте свой предел.\nИ буду ждать, собрав все силы,\nЧтобы убедиться: вы лишь мел.\n\n[Припев]\nВаша ложь, как чёрный дым,\nМы не станем стадом немым.\nЗа чеканом монет — пустота,\nЗа парадом побед — сирота.\nГрош цена вашим вечным делам,\nЕсли мир вы делите пополам.\nМы запомним всё, мы дождёмся конца,\nКогда смоет грим с вашего лица."}, {"i": "84", "t": "Unbreakable — A song about freedom of spirit in a world of lies", "s": "text"}, {"i": "85", "t": "Не спеши осуждать", "s": "text"}, {"i": "86", "t": "Loss Teaches Us — A track about what makes us Stronger", "s": "text"}, {"i": "87", "t": "Shadow of the Departed", "s": "text"}, {"i": "88", "t": "Don't Miss a Chance", "s": "text"}, {"i": "89", "t": "Act Now", "s": "text"}, {"i": "90", "t": "Just Love", "s": "text"}, {"i": "91", "t": "Code of Change", "s": "text"}, {"i": "92", "t": "Remain Human", "s": "text"}, {"i": "93", "t": "Time Drips (Remix)", "s": "text"}, {"i": "94", "t": "When the Lights Go Out", "s": "text"}, {"i": "95", "t": "The Meaning of Life is Simple", "s": "text"}, {"i": "96", "t": "Prisoners of the Past", "s": "text"}, {"i": "97", "t": "Pride is killing us", "s": "text"}, {"i": "98", "t": "Loneliness Among People", "s": "text"}, {"i": "99", "t": "The essence is simple", "s": "text"}, {"i": "100", "t": "Fear Is Not Weakness", "s": "text"}, {"i": "101", "t": "Remain Human", "s": "text"}, {"i": "102", "t": "You Alone Gave", "s": "text"}, {"i": "103", "t": "You're the Main Player", "s": "text"}, {"i": "104", "t": "Life Doesn't Forgive", "s": "text"}, {"i": "105", "t": "Сердце в Огне", "s": "text"}, {"i": "106", "t": "Не Угасай — трек который цепляет | Музыка для души", "s": "text"}, {"i": "107", "t": "Cherish Time – a track that makes you think | Music for the soul", "s": "text"}];
